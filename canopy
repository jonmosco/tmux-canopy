#!/usr/bin/env python3
"""Canopy setup and diagnostics. Run from the repository or add it to PATH."""
import argparse
import importlib.util
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime

ROOT = Path(__file__).resolve().parent
PLACEHOLDER = "/absolute/path/to/tmux-canopy"
KINDS = ("codex", "claude", "gemini", "agy", "pi", "omp", "opencode", "cursor-agent", "copilot", "grok")
EXECUTABLES = {"codex": "codex", "claude": "claude", "gemini": "gemini", "agy": "agy", "pi": "pi", "omp": "omp",
               "opencode": "opencode", "cursor-agent": "agent", "copilot": "copilot", "grok": "grok"}
TEMPLATES = {
    "codex": "codex-hooks.example.json",
    "claude": "claude-hooks.example.json",
    "gemini": "gemini-hooks.example.json",
    "agy": "agy-hooks.example.json",
    "pi": "pi-canopy.extension.ts",
    "omp": "pi-canopy.extension.ts",
    "opencode": "opencode-canopy.plugin.js",
    "cursor-agent": "cursor-agent-hooks.example.json",
    "copilot": "copilot-hooks.example.json",
    "grok": "grok-hooks.example.json",
}
# Agents that load every hook file in a directory get a file Canopy owns
# outright, so installing never edits the user's own hook configuration.
OWNED_HOOK_FILES = ("copilot", "grok")


def config_path(kind):
    home = Path.home()
    if kind == "codex":
        return Path(os.environ.get("CODEX_HOME", home / ".codex")).expanduser() / "hooks.json"
    if kind == "claude":
        return Path(os.environ.get("CLAUDE_CONFIG_DIR", home / ".claude")).expanduser() / "settings.json"
    if kind == "gemini":
        return home / ".gemini" / "settings.json"
    if kind == "agy":
        return Path(os.environ.get("AGY_HOOKS_PATH", home / ".gemini" / "config" / "hooks.json")).expanduser()
    if kind == "pi":
        return Path(os.environ.get("PI_CODING_AGENT_DIR", home / ".pi" / "agent")).expanduser() / "extensions" / "canopy-agent-state.ts"
    if kind == "omp":
        return home / ".omp" / "agent" / "extensions" / "canopy-agent-state.ts"
    if kind == "cursor-agent":
        return home / ".cursor" / "hooks.json"
    if kind == "copilot":
        return home / ".copilot" / "hooks" / "canopy.json"
    if kind == "grok":
        return Path(os.environ.get("GROK_HOME", home / ".grok")).expanduser() / "hooks" / "canopy.json"
    return Path(os.environ.get("XDG_CONFIG_HOME", home / ".config")).expanduser() / "opencode" / "plugins" / "canopy-agent-state.js"


def legacy_agy_path():
    return Path(os.environ.get("AGY_CONFIG_DIR", Path.home() / ".gemini" / "antigravity-cli")).expanduser() / "settings.json"


def hook_commands(data):
    """Every command string in a hook file, in either field Canopy writes."""
    return [action.get(field) for groups in data.get("hooks", {}).values() if isinstance(groups, list)
            for group in groups if isinstance(group, dict)
            for action in (group.get("hooks") if isinstance(group.get("hooks"), list) else [group])
            if isinstance(action, dict) for field in ("bash", "command") if field in action]


def owned_template(kind):
    data = json.loads((ROOT / "docs" / TEMPLATES[kind]).read_text())
    command = shlex.quote(str(ROOT / "scripts" / "agent-hook"))
    for groups in data["hooks"].values():
        for group in groups:
            for action in group.get("hooks", [group]):
                field = "bash" if "bash" in action else "command"
                action[field] = action[field].replace(PLACEHOLDER + "/scripts/agent-hook", command)
    return json.dumps(data, indent=2) + "\n"


def owned_state(kind):
    path = config_path(kind)
    if not path.exists():
        return "absent"
    content = path.read_text()
    if content == template(kind):
        return "installed"
    # Only a moved checkout is safe to rewrite: the file must match the
    # template once each command's script path is swapped for this one.
    try:
        data = json.loads(content)
    except ValueError:
        return "modified (review manually)"
    commands = hook_commands(data)
    if not commands or not all(is_ours(command, kind) for command in commands):
        return "modified (review manually)"
    script = shlex.quote(str(ROOT / "scripts" / "agent-hook"))
    for groups in data["hooks"].values():
        for group in groups:
            for action in group.get("hooks", [group]):
                field = "bash" if "bash" in action else "command"
                action[field] = " ".join([script] + shlex.split(action[field])[1:])
    return "outdated path" if json.dumps(data, indent=2) + "\n" == template(kind) else "modified (review manually)"


def template(kind):
    if kind in OWNED_HOOK_FILES:
        return owned_template(kind)
    content = (ROOT / "docs" / TEMPLATES[kind]).read_text()
    if kind in ("codex", "claude", "gemini", "agy", "cursor-agent"):
        return json.loads(content.replace(PLACEHOLDER, shlex.quote(str(ROOT))))
    content = content.replace("'" + PLACEHOLDER + "/scripts/agent-hook'", json.dumps(str(ROOT / "scripts" / "agent-hook")))
    if kind == "omp":
        content = content.replace("const kind = 'pi';", "const kind = 'omp';")
    return content


def read_json(path):
    if not path.exists():
        return {}
    value = json.loads(path.read_text())
    if not isinstance(value, dict):
        raise ValueError(f"{path}: expected a JSON object")
    if "hooks" in value and not isinstance(value["hooks"], dict):
        raise ValueError(f"{path}: hooks must be an object")
    return value


def is_ours(command, kind):
    if not isinstance(command, str):
        return False
    try:
        parts = shlex.split(command)
    except ValueError:
        return False
    script = "codex-hook" if kind == "codex" else "agent-hook"
    if not parts or not parts[0].endswith("/scripts/" + script):
        return False
    if kind == "codex":
        return len(parts) == 1
    if kind in ("agy", "copilot"):
        return len(parts) in (2, 3) and parts[1] == kind
    return len(parts) == 2 and parts[1] == kind


def count_hooks(data, kind):
    return sum(1 for groups in data.get("hooks", {}).values() for group in groups if isinstance(group, dict)
               for action in group.get("hooks", []) if isinstance(action, dict) and is_ours(action.get("command"), kind))


def merge_hooks(data, kind):
    hooks = data.setdefault("hooks", {})
    for event, groups in template(kind)["hooks"].items():
        existing = hooks.setdefault(event, [])
        if not isinstance(existing, list):
            raise ValueError(f"{event}: expected a hook list")
        for group in groups:
            matcher = group.get("matcher")
            found = False
            for item in existing:
                if not isinstance(item, dict) or item.get("matcher") != matcher:
                    continue
                for action in item.get("hooks", []):
                    if isinstance(action, dict) and is_ours(action.get("command"), kind):
                        action.update(group["hooks"][0])
                        found = True
                        break
                if found:
                    break
            if not found:
                existing.append(group)


def remove_hooks(data, kind):
    for event, groups in list(data.get("hooks", {}).items()):
        if not isinstance(groups, list):
            continue
        kept = []
        for group in groups:
            if not isinstance(group, dict) or not isinstance(group.get("hooks"), list):
                kept.append(group)
                continue
            actions = [action for action in group["hooks"] if not
                       (isinstance(action, dict) and is_ours(action.get("command"), kind))]
            if actions:
                group["hooks"] = actions
                kept.append(group)
        if kept:
            data["hooks"][event] = kept
        else:
            del data["hooks"][event]
    if not data.get("hooks"):
        data.pop("hooks", None)


def is_cursor_entry(item, kind):
    return isinstance(item, dict) and is_ours(item.get("command"), kind)


def count_cursor_hooks(data, kind):
    return sum(1 for groups in data.get("hooks", {}).values() if isinstance(groups, list)
               for item in groups if is_cursor_entry(item, kind))


def merge_cursor_hooks(data, kind):
    data.setdefault("version", 1)
    hooks = data.setdefault("hooks", {})
    for event, entries in template(kind)["hooks"].items():
        existing = hooks.setdefault(event, [])
        if not isinstance(existing, list):
            raise ValueError(f"{event}: expected a hook list")
        wanted = entries[0]
        found = False
        for item in existing:
            if is_cursor_entry(item, kind):
                item.clear(); item.update(wanted); found = True; break
        if not found:
            existing.append(dict(wanted))


def remove_cursor_hooks(data, kind):
    for event, groups in list(data.get("hooks", {}).items()):
        if not isinstance(groups, list):
            continue
        kept = [item for item in groups if not is_cursor_entry(item, kind)]
        if kept:
            data["hooks"][event] = kept
        else:
            del data["hooks"][event]
    if not data.get("hooks"):
        data.pop("hooks", None)


def write_safely(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        stamp = datetime.now().strftime("%Y%m%d-%H%M%S-%f")
        backup = path.with_name(path.name + ".canopy-backup-" + stamp)
        if backup.exists():
            raise ValueError(f"backup already exists: {backup}")
        shutil.copy2(path, backup)
        print(f"backup: {backup}")
    fd, tmp = tempfile.mkstemp(prefix=".canopy-", dir=path.parent)
    try:
        if path.exists():
            os.fchmod(fd, path.stat().st_mode & 0o777)
        else:
            os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as stream:
            stream.write(content)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def agy_commands(data):
    block = data.get("tmux-canopy", {})
    if not isinstance(block, dict):
        return []
    return [action.get("command") for event, entries in block.items() if isinstance(entries, list)
            for entry in entries if isinstance(entry, dict)
            for action in (entry.get("hooks", []) if isinstance(entry.get("hooks"), list) else [entry])
            if isinstance(action, dict)]


def agy_state():
    data = read_json(config_path("agy"))
    wanted = template("agy")["tmux-canopy"]
    actual = data.get("tmux-canopy")
    legacy = read_json(legacy_agy_path())
    has_legacy = count_hooks(legacy, "agy") > 0
    if actual == wanted:
        return "partial" if has_legacy else "installed"
    if actual is not None:
        commands = agy_commands(data)
        if commands and all(is_ours(command, "agy") for command in commands):
            current_root = str(ROOT)
            if not all(current_root in command for command in commands):
                return "outdated path"
            return "partial"
        return "modified (review manually)"
    return "legacy install" if has_legacy else "absent"


def integration_state(kind):
    path = config_path(kind)
    if kind == "agy":
        return agy_state()
    if kind in OWNED_HOOK_FILES:
        return owned_state(kind)
    if kind in ("codex", "claude", "gemini"):
        data = read_json(path)
        expected = template(kind)["hooks"]
        present = [event for event in expected if any(
            isinstance(group, dict) and any(isinstance(action, dict) and is_ours(action.get("command"), kind)
                                            for action in group.get("hooks", []))
            for group in data.get("hooks", {}).get(event, []))]
        current = [event for event, groups in expected.items() if any(
            isinstance(group, dict) and any(isinstance(action, dict) and action.get("command") == required["command"]
                                            for action in group.get("hooks", []))
            for group in data.get("hooks", {}).get(event, []) for required in groups[0]["hooks"])]
        state = ("installed" if len(current) == len(expected) else
                 "outdated path" if len(present) == len(expected) else
                 "partial" if count_hooks(data, kind) else "absent")
    elif kind == "cursor-agent":
        data = read_json(path)
        expected = template(kind)["hooks"]
        present = [event for event in expected if any(
            is_cursor_entry(item, kind) for item in data.get("hooks", {}).get(event, []) if isinstance(item, dict))]
        current = [event for event, entries in expected.items() if any(
            isinstance(item, dict) and item.get("command") == entries[0]["command"]
            for item in data.get("hooks", {}).get(event, []))]
        state = ("installed" if len(current) == len(expected) else
                 "outdated path" if len(present) == len(expected) else
                 "partial" if count_cursor_hooks(data, kind) else "absent")
    elif not path.exists():
        state = "absent"
    else:
        state = "installed" if path.read_text() == template(kind) else "modified (review manually)"
    return state


def status(kind):
    available = "found" if shutil.which(EXECUTABLES[kind]) else "not on PATH"
    return f"{kind:12} {integration_state(kind):26} CLI {available:11} {config_path(kind)}"


def load_module(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


# Representative events that each reporter must turn into a pane status.
SELF_TEST_EVENTS = {
    "codex": ({"hook_event_name": "PermissionRequest", "session_id": "self-test",
               "tool_name": "Bash", "tool_input": {"command": "true"}}, "needs-input"),
    "claude": ({"hook_event_name": "PermissionRequest", "session_id": "self-test",
                "tool_name": "Bash", "tool_input": {"command": "true"}}, "needs-input"),
    "gemini": ({"hook_event_name": "Notification", "session_id": "self-test",
                "notification_type": "ToolPermission"}, "needs-input"),
    "agy": ({"conversationId": "self-test", "invocationNum": 0,
             "initialNumSteps": 0}, "working"),
    "opencode": ({"type": "session.created", "properties": {"sessionID": "self-test",
                  "info": {"id": "self-test", "directory": "/tmp"}}}, "ready"),
    "pi": ({"type": "agent_start", "session_id": "self-test"}, "working"),
