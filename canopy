}


def reporter_self_test():
    """Run each reporter's real report path with only tmux and ps stubbed out.

    This catches reporters drifting from the shared reporting module, which
    otherwise fail silently because hooks must never print or exit nonzero.
    """
    failures = []
    for kind, (event, expected) in SELF_TEST_EVENTS.items():
        written = {}

        def fake_tmux(*args):
            output = ""
            if args[:1] == ("display-message",) and args[-1].startswith("#{pane_id}|"):
                output = "%0|4000|0||\n"
            elif args[:2] == ("list-panes", "-a"):
                output = "%0|4000|0||0|/tmp|||||\n"
            # write() chains: set-option -pq -t PANE KEY VALUE ; ...
            for i, arg in enumerate(args[:-5]):
                if arg == "set-option":
                    written[args[i + 4]] = args[i + 5]
            return subprocess.CompletedProcess(args, 0, output, "")
        try:
            hook = load_module("canopy_agent_hook", ROOT / "lib" / "agent-hook.py")
            core = hook.core
            core.PANE = "%0"
            core.tmux = fake_tmux
            core.process_identity = lambda root, kind="codex": ("4001", "123")
            core.refresh = lambda: None
            if kind == "codex":
                codex = load_module("canopy_codex_hook", ROOT / "lib" / "codex-hook.py")
                if codex.core is not core:
                    raise RuntimeError("Codex does not use the shared reporting module")
                codex.report(event)
            else:
                hook.report(kind, event, {"agy": "PreInvocation", "copilot": "notification"}.get(kind))
        except Exception as error:  # Any exception here is a silent failure in a real hook.
            failures.append(f"{kind}: {type(error).__name__}: {error}")
            continue
        if written.get(core.PREFIX + "status") != expected:
            failures.append(f"{kind}: event did not record status {expected!r}")
    return failures


def change_agy(action, dry_run=False):
    path = config_path("agy")
    legacy_path = legacy_agy_path()
    if path.is_symlink():
        path = path.resolve()
    if legacy_path.is_symlink():
        legacy_path = legacy_path.resolve()
    data = read_json(path)
    legacy = read_json(legacy_path)
    original = json.dumps(data, sort_keys=True)
    legacy_original = json.dumps(legacy, sort_keys=True)
    existing = data.get("tmux-canopy")
    if existing is not None:
        commands = agy_commands(data)
        if not commands or not all(is_ours(command, "agy") for command in commands):
            raise ValueError(f"{path}: tmux-canopy hook has unrecognized content; review it manually")
    if action == "install":
        data["tmux-canopy"] = template("agy")["tmux-canopy"]
    else:
        data.pop("tmux-canopy", None)
    remove_hooks(legacy, "agy")
    changed = json.dumps(data, sort_keys=True) != original
    legacy_changed = json.dumps(legacy, sort_keys=True) != legacy_original
    if not changed and not legacy_changed:
        print(f"agy: already {'installed' if action == 'install' else 'absent'}")
        return
    if dry_run:
        if changed:
            print(f"would {action}: agy -> {path}")
        if legacy_changed:
            print(f"would remove legacy agy hooks -> {legacy_path}")
        return
    if changed:
        write_safely(path, json.dumps(data, indent=2, ensure_ascii=False) + "\n")
        print(f"{action}ed: agy -> {path}")
    if legacy_changed:
        write_safely(legacy_path, json.dumps(legacy, indent=2, ensure_ascii=False) + "\n")
        print(f"removed legacy agy hooks: {legacy_path}")


def change(kind, action, dry_run=False):
    if kind == "agy":
        return change_agy(action, dry_run)
    path = config_path(kind)
    if path.is_symlink():
        path = path.resolve()
    if kind in ("codex", "claude", "gemini", "cursor-agent"):
        data = read_json(path)
        before = json.dumps(data, sort_keys=True)
        if action == "install":
            (merge_cursor_hooks if kind == "cursor-agent" else merge_hooks)(data, kind)
        else:
            (remove_cursor_hooks if kind == "cursor-agent" else remove_hooks)(data, kind)
        after = json.dumps(data, sort_keys=True)
        if before == after:
            print(f"{kind}: already {'installed' if action == 'install' else 'absent'}")
            return
        content = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
    else:
        wanted = template(kind)
        current = path.read_text() if path.exists() else None
        if current is not None and current != wanted and not (
                kind in OWNED_HOOK_FILES and owned_state(kind) == "outdated path"):
            raise ValueError(f"{path}: existing file was modified; review it manually")
        if action == "install" and current == wanted or action == "uninstall" and current is None:
            print(f"{kind}: already {'installed' if action == 'install' else 'absent'}")
            return
        content = wanted if action == "install" else None
    if dry_run:
        print(f"would {action}: {kind} -> {path}")
    elif content is None:
        path.unlink()
        print(f"removed: {path}")
    else:
        write_safely(path, content)
        if kind == "opencode" and action == "install":
            pkg = path.parent.parent / "package.json"
            try:
                pkg_data = json.loads(pkg.read_text()) if pkg.exists() else {}
            except (OSError, ValueError):
                pkg_data = {}
            if pkg_data.get("type") != "module":
                pkg_data["type"] = "module"
                write_safely(pkg, json.dumps(pkg_data, indent=2) + "\n")
                print(f"  set type: module in {pkg}")
        print(f"{action}ed: {kind} -> {path}")


def live_agents():
    """Yield (pane, kind, source, updated) for agent processes running in panes."""
    sys.path.insert(0, str(ROOT / "lib"))
    from agent_kinds import KINDS as PROCESS_KINDS, name_from_args
    fields = "#{pane_id}|#{pane_pid}|#{@tmux_canopy}|#{@tmux_canopy_slot}|#{@tmux_canopy_agent_source}|#{@tmux_canopy_agent_updated}"
    panes = subprocess.run(("tmux", "list-panes", "-a", "-F", fields), text=True,
                           capture_output=True, timeout=5, check=False)
    if panes.returncode:
        return None
    owners = {}
    for line in panes.stdout.splitlines():
        pane, pid, sidebar, slot, source, updated = (line.split("|") + [""] * 6)[:6]
        if pid.isdigit() and sidebar != "1" and slot != "1":
            owners[int(pid)] = (pane, source, updated)
    parents, found = {}, {}
    # args= exposes argv0 for Node CLIs whose comm is a thread name (e.g. MainThread).
    records = subprocess.run(("ps", "-eo", "pid=,ppid=,args="), text=True,
                             capture_output=True, timeout=5, check=False).stdout
    candidates = []
    for line in records.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            parents[int(parts[0])] = int(parts[1])
            kind = PROCESS_KINDS.get(name_from_args(parts[2].split()))
            if kind:
                candidates.append((int(parts[0]), kind))
    for pid, kind in candidates:
        current = pid
        for _ in range(128):
            if current in owners:
                found.setdefault(owners[current][0], (kind,) + owners[current][1:])
                break
            current = parents.get(current, 0)
            if current <= 1:
                break
    return sorted((pane,) + value for pane, value in found.items())


def show_live_agents():
    agents = live_agents()
    if agents is None:
        print("  No tmux server reachable.")
        return
    if not agents:
        print("  No supported agent processes found in tmux panes.")
        return
    now = int(datetime.now().timestamp())
    for pane, kind, source, updated in agents:
        if source == kind + "-hook" and updated.isdigit():
            age = now - int(updated)
            note = f"last report {age}s ago" + (" (stale; status clears after 900s)" if age > 900 else "")
        else:
            try:
                state = integration_state(kind)
            except (OSError, ValueError, TypeError, KeyError):
                state = "unreadable"
            if state == "installed":
                note = "no report yet; hooks load at startup, so restart this agent if it predates the install"
                if kind == "codex":
                    note += "; Codex also requires trusting new hooks via /hooks"
            else:
                note = f"no report; integration {state} (canopy integration install {kind})"
        print(f"  {pane:6} {kind:12} {note}")


def show_status(kinds):
    result = 0
    for kind in kinds:
        try:
            print(status(kind))
        except (OSError, ValueError, TypeError) as error:
            print(f"{kind:12} error: {error}", file=sys.stderr)
            result = 1
    return result


def main():
    parser = argparse.ArgumentParser(description="Canopy tmux diagnostics and agent integrations")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("doctor", help="check Canopy and show tmux ownership")
    commands.add_parser("setup", help="choose optional agent integrations")
    integrations = commands.add_parser("integration", help="manage agent lifecycle reporters")
    integrations.add_argument("action", choices=("status", "install", "uninstall"))
    integrations.add_argument("kinds", nargs="*", choices=KINDS)
    integrations.add_argument("--dry-run", action="store_true")
    alerts = commands.add_parser("alerts", help="send a sample alert")
    alerts.add_argument("action", choices=("test",))
    alerts.add_argument("mode", nargs="?", choices=("desktop", "tmux", "both"),
                        help="defaults to @tmux-canopy-alerts, or both when it is off")
    args = parser.parse_args()
    if args.command == "alerts":
        mode = args.mode or subprocess.run(("tmux", "show-option", "-gqv", "@tmux_canopy_alerts"),
                                           text=True, capture_output=True, timeout=5,
                                           check=False).stdout.strip()
        if mode not in ("desktop", "tmux", "both"):
            mode = "both"
        return subprocess.call([str(ROOT / "scripts" / "alert"), "--test", mode])
    if args.command == "doctor":
        result = subprocess.call([str(ROOT / "scripts" / "doctor"), "--report"])
        print("\nAgent integrations:")
        integration_result = show_status(KINDS)
        print("\nReporter self-test (stubbed tmux, real report path):")
        failures = reporter_self_test()
        print("  OK" if not failures else "\n".join("  FAILED " + failure for failure in failures))
        print("\nAgents running in tmux panes:")
        show_live_agents()
        return result or integration_result or (1 if failures else 0)
    if args.command == "setup":
        args.action, args.kinds, args.dry_run = "install", [], False
    if args.action == "status":
        return show_status(args.kinds or KINDS)
    if not args.kinds:
        if not sys.stdin.isatty():
            parser.error("specify one or more agents in noninteractive mode")
        print("Optional agent lifecycle integrations (Python 3 required):")
        show_status(KINDS)
        chosen = input("Agents to " + args.action + " (comma separated, 'detected', or 'all'; empty cancels): ").strip().lower()
        if not chosen:
            return 0
        args.kinds = (KINDS if chosen == "all" else
                      [kind for kind in KINDS if shutil.which(EXECUTABLES[kind])] if chosen == "detected" else
                      [part.strip() for part in chosen.split(",")])
        if not args.kinds:
            print("No supported agent CLIs found on PATH.")
            return 0
    if any(kind not in KINDS for kind in args.kinds):
        parser.error("unknown agent; choose from " + ", ".join(KINDS))
    result = 0
    for kind in dict.fromkeys(args.kinds):
        try:
            change(kind, args.action, args.dry_run)
        except (OSError, ValueError, TypeError) as error:
            print(f"{kind}: {error}", file=sys.stderr)
            result = 1
    if args.action == "install" and not args.dry_run and result == 0:
        print("To show agent rows, set -g @tmux-canopy-agents on, reload tmux config, and reopen Canopy.")
    return result


if __name__ == "__main__":
    sys.exit(main())
