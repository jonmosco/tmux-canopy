#!/usr/bin/env bash
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/launch-lib.sh"
action="${1:-}"
subject="${2:-}"
printf -v now '%(%s)T' -1

# The claim is evaluated inside tmux's command queue, not in competing shells.
# One short-lived worker per burst; an expired claim can recover after SIGKILL.
refresh_command() {
  local token="$now.$$.$RANDOM" body job
  job="run-shell -b $(tmux_quote "$(tmux_shell "$SCRIPT_DIR/notify" refresh "$token")")"
  body="set-option -gq @tmux_canopy_notice_pending $token ; set-option -gq @tmux_canopy_notice_deadline $((now + 2)) ; $job"
  printf 'if-shell -F %s %s' "$(tmux_quote "#{||:#{!:#{@tmux_canopy_notice_pending}},#{<:#{@tmux_canopy_notice_deadline},$now}}")" "$(tmux_quote "$body")"
}

if [[ "$action" == refresh ]]; then
  token="$subject"
  [[ "$token" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || exit 0
  release="set-option -gu @tmux_canopy_notice_pending ; set-option -gu @tmux_canopy_notice_deadline"
  match="#{==:#{@tmux_canopy_notice_pending},$token}"
  # shellcheck disable=SC2329
  release_claim() { tmux if-shell -F "$match" "$release" 2>/dev/null || true; }
  trap release_claim EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  sleep 0.12
  delivery=''
  while IFS= read -r sidebar; do
    [[ "$sidebar" =~ ^%[0-9]+$ ]] && delivery+="send-keys -t $sidebar C-r ; "
  done < <(tmux list-panes -a -f '#{==:#{@tmux_canopy},1}' -F '#{pane_id}' 2>/dev/null)
  tmux if-shell -F "$match" "${delivery}${release}" 2>/dev/null || true
  trap - EXIT
  exit 0
fi

if [[ "$action" == set ]]; then
  pane="${3:-}"; provider="${4:-}"
  [[ "$subject" =~ ^@[0-9]+$ && "$pane" =~ ^%[0-9]+$ && "$provider" =~ ^(activity|bell|silence)$ ]] || exit 0
  option="@tmux_canopy_notice_$provider"
  pane_option="@tmux_canopy_notice_pane_$provider"
  info="$(tmux display-message -p -t "$pane" "#{window_id}|#{pane_dead}|#{@tmux_canopy}|#{@tmux_canopy_slot}|#{@tmux_canopy_notifications}|#{$pane_option}" 2>/dev/null)" || exit 0
  IFS='|' read -r window dead sidebar slot configured recorded <<< "$info"
  [[ "$window" == "$subject" && "$dead" != 1 && "$sidebar" != 1 && "$slot" != 1 ]] || exit 0
  [[ ",$configured," == *",$provider,"* || ",$configured," == *,all,* ]] || exit 0
  # A pane-only name avoids inheriting the window aggregate through formats.
  # Recheck in tmux's queue so concurrent identical events cause one write and
  # one refresh, even when their initial snapshots all saw an unread flag of 0.
  [[ "$recorded" == 1 ]] && exit 0
  condition="#{&&:#{!=:#{$pane_option},1},#{&&:#{==:#{window_id},$subject},#{&&:#{!=:#{pane_dead},1},#{&&:#{!=:#{@tmux_canopy},1},#{!=:#{@tmux_canopy_slot},1}}}}}"
  tmux if-shell -F -t "$pane" "$condition" \
    "set-option -pq -t $pane $pane_option 1 ; set-option -pq -t $pane $option 1 ; set-option -wq -t $subject $option 1 ; $(refresh_command)"
  exit 0
fi

case "$action" in clear-window|clear-session|clear-all|clear-client) ;; *) exit 0 ;; esac
selected_window=''
scheduled_window="${3:-}"
declare -A selected=() seen_windows=() seen_panes=()
commands=()
window_commands=()
# One snapshot, then one mutation batch. No separate traversal per provider.
while IFS='|' read -r kind a b c d e f g h; do
  case "$kind" in
    C) [[ "$action" == clear-client && "$a" == "$subject" ]] && selected_window="$b" ;;
    W)
      if [[ "$action" == clear-all || ( "$action" == clear-session && "$a" == "$subject" ) || \
            ( "$action" == clear-window && "$b" == "$subject" ) || \
            ( "$action" == clear-client && -n "$selected_window" && "$b" == "$selected_window" ) ]]; then
        selected["$b"]=1
        [[ -n "${seen_windows[$b]:-}" ]] && continue
        seen_windows["$b"]=1
        flags=("$c" "$d" "$e"); providers=(activity bell silence)
        for i in 0 1 2; do
          [[ "${flags[i]}" == 1 ]] && window_commands+=(set-option -wu -t "$b" "@tmux_canopy_notice_${providers[i]}" ';')
        done
      fi
      ;;
    P)
      [[ -n "${selected[$a]:-}" && -z "${seen_panes[$b]:-}" ]] || continue
      seen_panes["$b"]=1
      flags=("$c" "$d" "$e"); pane_flags=("$f" "$g" "$h"); providers=(activity bell silence)
      for i in 0 1 2; do
        [[ "${flags[i]}" == 1 ]] && commands+=(set-option -pu -t "$b" "@tmux_canopy_notice_${providers[i]}" ';')
        [[ "${pane_flags[i]}" == 1 ]] && commands+=(set-option -pu -t "$b" "@tmux_canopy_notice_pane_${providers[i]}" ';')
      done
      ;;
  esac
done < <(tmux list-clients -F 'C|#{client_tty}|#{window_id}' \; \
  list-windows -a -F 'W|#{session_id}|#{window_id}|#{@tmux_canopy_notice_activity}|#{@tmux_canopy_notice_bell}|#{@tmux_canopy_notice_silence}' \; \
  list-panes -a -F 'P|#{window_id}|#{pane_id}|#{@tmux_canopy_notice_activity}|#{@tmux_canopy_notice_bell}|#{@tmux_canopy_notice_silence}|#{@tmux_canopy_notice_pane_activity}|#{@tmux_canopy_notice_pane_bell}|#{@tmux_canopy_notice_pane_silence}' 2>/dev/null)
# Keep aggregates set until pane clears succeed. If a pane disappears between
# snapshot and mutation, a subsequent focus can retry instead of hiding unread
# pane state behind an already-cleared window aggregate.
commands+=("${window_commands[@]}")
changed=${#commands[@]}
# Hooks claim a scheduled window before starting this script. Release that
# exact claim even if the client has since switched again or detached.
if [[ "$action" == clear-client && "$scheduled_window" =~ ^@[0-9]+$ ]]; then
  claim="${4:-}"
  if [[ "$claim" =~ ^[0-9]+$ ]]; then
    commands+=(if-shell -F -t "$scheduled_window" "#{==:#{@tmux_canopy_notice_clear_pending},$claim}" "set-option -wu -t $scheduled_window @tmux_canopy_notice_clear_pending" ';')
  else
    commands+=(set-option -wu -t "$scheduled_window" @tmux_canopy_notice_clear_pending ';')
  fi
fi
if ((changed)) && [[ "$action" != clear-client && "${TMUX_CANOPY_NOTIFY_QUIET:-0}" != 1 ]]; then
  commands+=(if-shell -F 1 "$(refresh_command)")
fi
if ((${#commands[@]})); then tmux "${commands[@]}" 2>/dev/null || true; fi
