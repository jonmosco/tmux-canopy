#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"

action="${1:-}"
sidebar="${2:-}"
value="${3:-}"
[[ -n "$sidebar" ]] || exit 0

IFS='|' read -r is_canopy current minimum maximum min_content presets < <(
  tmux display-message -p -t "$sidebar" \
    '#{@tmux_canopy}|#{pane_width}|#{@tmux-canopy-min-width}|#{@tmux-canopy-max-width}|#{@tmux-canopy-min-content-width}|#{@tmux-canopy-width-presets}' 2>/dev/null || true
)

[[ "$is_canopy" == '1' && "$current" =~ ^[1-9][0-9]*$ ]] || exit 0
: "${minimum:=24}"
: "${maximum:=0}"
: "${min_content:=40}"
: "${presets:=30,42,48}"

IFS=',' read -ra raw_widths <<< "$presets"
widths=()
for w in "${raw_widths[@]}"; do
  w="${w//[[:space:]]/}"
  if [[ "$w" =~ ^[1-9][0-9]*$ ]]; then
    inserted=0
    for ((idx=0; idx<${#widths[@]}; idx++)); do
      if ((w == widths[idx])); then
        inserted=1; break
      elif ((w < widths[idx])); then
        widths=("${widths[@]:0:idx}" "$w" "${widths[@]:idx}")
        inserted=1; break
      fi
    done
    ((inserted)) || widths+=("$w")
  fi
done
((${#widths[@]} > 0)) || widths=(30 42 48)

desired="$value"
case "$action" in
  previous)
    desired="${widths[-1]}"
    for candidate in "${widths[@]}"; do
      if ((candidate < current)); then desired="$candidate"; else break; fi
    done
    ;;
  next|cycle)
    desired="${widths[0]}"
    for candidate in "${widths[@]}"; do
      if ((candidate > current)); then desired="$candidate"; break; fi
    done
    ;;
  nearest)
    [[ "$value" =~ ^[0-9]+$ ]] || exit 0
    desired="${widths[0]}"
    best_distance=999999
    for candidate in "${widths[@]}"; do
      distance=$((candidate > value ? candidate - value : value - candidate))
      if ((distance < best_distance)); then
        desired="$candidate"
        best_distance="$distance"
      fi
    done
    ;;
  commit) ;;
  *) exit 0 ;;
esac

width="$(clamp_sidebar_width "$sidebar" "$desired" "$minimum" "$maximum" "$min_content" 2>/dev/null || true)"
[[ -n "$width" ]] || exit 0

# One geometry commit means one SIGWINCH/redraw for the sidebar and content.
tmux resize-pane -t "$sidebar" -x "$width" 2>/dev/null || exit 0
# Remember the user's choice, not a temporary narrow-window clamp.
tmux set-option -gq @tmux_canopy_runtime_width "$desired"
# Invalidate any old live-mode debounce before synchronizing slots once.
tmux set-option -gq @tmux_canopy_resize_nonce "commit-${EPOCHREALTIME:-$(date +%s)}-$RANDOM-$$"
sync_sidebar_slots "$desired" "$minimum" "$maximum" "$min_content"
