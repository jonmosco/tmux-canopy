#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
action="${1:-}"
mouse_pane="${2:-}"
window_id="${3:-}"
mouse_x="${4:-}"
mode="${5:-live}"

clear_markers() {
  local pane window
  while IFS= read -r pane; do
    if [[ -n "$pane" ]]; then
      tmux set-option -pu -t "$pane" @tmux_canopy_staged_sidebar \; \
        set-option -pu -t "$pane" @tmux_canopy_drag_width 2>/dev/null || true
    fi
  done < <(tmux list-panes -a -F $'#{pane_id}\t#{@tmux_canopy_staged_sidebar}' 2>/dev/null |
    awk -F '\t' '$2 != "" { print $1 }')
  while IFS= read -r window; do
    if [[ -n "$window" ]]; then
      tmux set-option -wu -t "$window" @tmux_canopy_staged_sidebar \; \
        set-option -wu -t "$window" @tmux_canopy_drag_native 2>/dev/null || true
    fi
  done < <(tmux list-windows -a -f '#{@tmux_canopy_staged_sidebar}' -F '#{window_id}' 2>/dev/null)
}

case "$action" in
  start)
    clear_markers
    [[ -n "$window_id" ]] || window_id="$(tmux display-message -p -t "$mouse_pane" '#{window_id}' 2>/dev/null || true)"
    while IFS='|' read -r sidebar left width; do
      [[ -n "$sidebar" && "$left" =~ ^[0-9]+$ && "$width" =~ ^[1-9][0-9]*$ ]] || continue
      border=$((left + width))
      native=0
      # Border coordinates are absent in tmux mouse-down formats. A right
      # dock shares its left border with content panes, whose horizontal
      # borders are indistinguishable at this point. Let tmux perform native
      # dragging and commit only an actual dock width change on release.
      if ((left > 0)) || [[ "$mode" == live ]]; then native=1; fi
      # tmux supplies mouse_pane but no mouse_x on the border itself. A
      # full-height left sidebar owns its right border. Numeric coordinates
      # remain supported for callers using the original helper interface.
      if ((native)) || [[ "$mouse_pane" == "$sidebar" && -z "$mouse_x" ]] ||
         { [[ "$mouse_x" =~ ^[0-9]+$ ]] && ((mouse_x >= border - 1 && mouse_x <= border + 1)); }; then
        tmux set-option -pq -t "$sidebar" @tmux_canopy_staged_sidebar "$sidebar" \; \
          set-option -pq -t "$sidebar" @tmux_canopy_drag_width "$width"
        tmux set-option -wq -t "$window_id" @tmux_canopy_drag_native "$native"
        if [[ -n "$mouse_pane" ]]; then
          tmux set-option -pq -t "$mouse_pane" @tmux_canopy_staged_sidebar "$sidebar" 2>/dev/null || true
        fi
        # Release may land inside any content pane, which inherits this marker.
        tmux set-option -wq -t "$window_id" @tmux_canopy_staged_sidebar "$sidebar"
        exit 0
      fi
    done < <(tmux list-panes -t "$window_id" -F '#{pane_id}|#{pane_left}|#{pane_width}|#{@tmux_canopy}' 2>/dev/null |
      awk -F '|' '$4 == "1" { print $1 "|" $2 "|" $3 }')
    ;;

  end)
    sidebar="$mouse_pane"
    [[ -n "$sidebar" ]] || { clear_markers; exit 0; }
    drag="$(tmux display-message -p -t "$sidebar" '#{@tmux_canopy_drag_native}|#{@tmux_canopy_drag_width}|#{pane_width}' 2>/dev/null || true)"
    IFS='|' read -r native initial current <<< "$drag"
    if [[ "$native" == 1 ]]; then
      # Ordinary content-border drags do not change the preferred dock width.
      if [[ "$current" =~ ^[1-9][0-9]*$ && "$current" != "$initial" ]]; then
        if [[ "$mode" == preset ]]; then
          "$SCRIPT_DIR/resize" nearest "$sidebar" "$current"
        else
          "$SCRIPT_DIR/resize" commit "$sidebar" "$current"
        fi
      fi
      clear_markers
      exit 0
    fi
    [[ "$mouse_x" =~ ^[0-9]+$ ]] || { clear_markers; exit 0; }
    left="$(tmux display-message -p -t "$sidebar" '#{pane_left}' 2>/dev/null || true)"
    [[ "$left" =~ ^[0-9]+$ ]] || left=0
    desired=$((mouse_x - left))
    ((desired > 0)) || { clear_markers; exit 0; }
    if [[ "$mode" == 'preset' ]]; then
      "$SCRIPT_DIR/resize" nearest "$sidebar" "$desired"
    else
      "$SCRIPT_DIR/resize" commit "$sidebar" "$desired"
    fi
    clear_markers
    ;;

  clear)
    clear_markers
    ;;
esac
