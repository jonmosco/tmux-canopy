#!/usr/bin/env bash
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/launch-lib.sh"
state_file="${TMUX_CANOPY_STATE:?}"
# ASCII unit separator is reserved for snapshot fields. Scrub control bytes
# (including newlines, tabs, ESC and the separator) inside user-supplied text.
sep=$'\037'
text() { printf '#{s/[\001-\037\177]/ /:%s}' "$1"; }
config="D${sep}#{@tmux_canopy_icon_theme}${sep}#{@tmux_canopy_notifications}${sep}#{@tmux-canopy-theme}${sep}#{@tmux-canopy-density}${sep}$(text @tmux-canopy-icon-session)${sep}$(text @tmux-canopy-icon-window)${sep}$(text @tmux-canopy-icon-pane)${sep}#{pane_id}${sep}#{window_id}${sep}#{session_id}${sep}#{pane_width}${sep}$(text host)${sep}#{@tmux-canopy-compact-single-panes}${sep}$(text @tmux-canopy-filter)${sep}$(text @tmux-canopy-filter-window)${sep}$(text @tmux-canopy-filter-title)"
# Keep overrides in the same batched tmux snapshot as the tree. The renderer
# reads these fields in this order, after the existing configuration fields.
for app in nvim vim shell node python git ssh kubectl claude codex gemini pi omp opencode agent antigravity make top crush copilot grok hermes; do
  config+="${sep}$(text "@tmux-canopy-icon-$app")"
done
# Appearance before agents so agents remains the final D field for tree-source.
config+="${sep}#{@tmux_canopy_appearance}${sep}#{@tmux-canopy-git-context}"
# The client's effective agents setting (saved on/off, else the global
# default) resolves inside this same tmux call when the client is known.
agents_client="${TMUX_CANOPY_CLIENT:-${TMUX_CANOPY_RENDER_CLIENT:-}}"
if [[ -n "$agents_client" ]]; then
  canopy_client_key "$agents_client"
  agents_option="@tmux_canopy_agents_$CANOPY_KEY"
  config+="${sep}#{?#{==:#{$agents_option},on},on,#{?#{==:#{$agents_option},off},off,#{@tmux-canopy-agents}}}"
else
  config+="${sep}#{@tmux-canopy-agents}"
fi
sessions="S${sep}#{session_id}${sep}$(text session_name)${sep}#{session_attached}"
windows="W${sep}#{session_id}${sep}#{window_id}${sep}#{window_index}${sep}$(text window_name)${sep}#{window_linked_sessions}${sep}#{synchronize-panes}${sep}#{@tmux_canopy_notice_activity}${sep}#{@tmux_canopy_notice_bell}${sep}#{@tmux_canopy_notice_silence}${sep}#{window_zoomed_flag}"
panes="P${sep}#{pane_id}${sep}#{window_id}${sep}#{pane_index}${sep}$(text pane_current_command)${sep}$(text pane_title)${sep}$(text pane_current_path)${sep}#{pane_dead}${sep}#{@tmux_canopy}${sep}#{@tmux_canopy_slot}${sep}#{@tmux_canopy_notice_pane_activity}${sep}#{@tmux_canopy_notice_pane_bell}${sep}#{@tmux_canopy_notice_pane_silence}${sep}#{@tmux_canopy_target}${sep}#{@tmux_canopy_target_session}${sep}#{pane_last}${sep}#{pane_pid}${sep}#{@tmux_canopy_agent_source}${sep}$(text @tmux_canopy_agent_session)${sep}#{@tmux_canopy_agent_pane_pid}${sep}#{@tmux_canopy_agent_status}${sep}#{@tmux_canopy_agent_updated}${sep}#{@tmux_canopy_agent_process_pid}${sep}$(text @tmux_canopy_agent_process_birth)${sep}$(text @tmux_canopy_agent_subagents)${sep}#{?window_zoomed_flag,#{pane_active},0}"
clients="C${sep}#{client_tty}${sep}#{session_id}${sep}#{window_id}${sep}#{pane_id}"
if ! printf -v now '%(%s)T' -1 2>/dev/null || [[ -z "$now" ]]; then
  now="$(date +%s)"
fi
# Collect completely before publishing any rows. One tmux connection, no
# per-session/window/pane subprocesses; the renderer performs all aggregation.
snapshot="$(tmux display-message -p -t "${TMUX_PANE:-}" "$config" \; \
  list-sessions -F "$sessions" \; list-windows -a -F "$windows" \; \
  list-panes -a -F "$panes" \; list-clients -F "$clients" 2>/dev/null)" || exit 1
config_row="${snapshot%%$'\n'*}"
if [[ -n "$agents_client" ]]; then
  agents_enabled=${config_row##*"$sep"}
  [[ "$agents_enabled" == on ]] || agents_enabled=off
else
  # No client in the environment: canopy_agents_enabled finds the sidebar's
  # owner from its pane option.
  if canopy_agents_enabled; then agents_enabled=on; else agents_enabled=off; fi
fi
config_row="${config_row%"$sep"*}${sep}${agents_enabled}"
git_mode=${config_row%"$sep"*}
git_mode=${git_mode##*"$sep"}
if [[ "$snapshot" == *$'\n'* ]]; then
  snapshot="${config_row}"$'
'"${snapshot#*$'\n'}"
else
  snapshot="$config_row"
fi
export TMUX_CANOPY_RENDER_CLIENT="${TMUX_CANOPY_CLIENT:-}"
export TMUX_CANOPY_RENDER_HOME="$HOME"
switcher=0 agent_view=0
export TMUX_CANOPY_FILTER_TARGET="" TMUX_CANOPY_NEEDS_INPUT=""
while (($#)); do
  case "$1" in
    --focus-target) export TMUX_CANOPY_FILTER_TARGET="${2:-}"; shift ;;
    --switcher) switcher=1 ;;
    --agents) agent_view=1 ;;
    # Always at agent_view detection strength: a wrapper-shell agent must
    # still be found, regardless of which view is currently on screen.
    --needs-input) agent_view=1; export TMUX_CANOPY_NEEDS_INPUT=1 ;;
  esac
  shift
done
# tmux reports Pi's executable (node). Show pi/omp when that process is the agent.
# Only a pane row's command field counts; a window or title named node does not.
field="[^${sep}]*${sep}"
node_row="(^|"$'\n'")P${sep}${field}${field}${field}(node|nodejs|python[0-9.]*|Python)${sep}"
if [[ "$snapshot" =~ $node_row ]]; then
  # shellcheck disable=SC1091
  source "$SCRIPT_DIR/../lib/agent-process.sh"
  # Load once in this shell; every pane lookup below reuses the cached table.
  canopy_load_ps_snapshot
  relabeled=''
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == P$sep* ]]; then
      IFS="$sep" read -ra fields <<< "$line"
      if [[ ${fields[4]:-} =~ ^(node|nodejs|python[0-9.]*|Python)$ ]]; then
        canopy_pane_agent "${fields[16]:-}" >/dev/null
        kind=$CANOPY_REPLY
        if [[ -n $kind ]]; then
          fields[4]=$kind
          line=${fields[0]}
          for ((i=1; i<${#fields[@]}; i++)); do line+=$sep${fields[i]}; done
        fi
      fi
    fi
    relabeled+="$line"$'\n'
  done <<< "$snapshot"
  snapshot=${relabeled%$'\n'}
fi
if [[ "$agents_enabled" != on ]]; then
  [[ -z "$TMUX_CANOPY_NEEDS_INPUT" ]] || exit 0
  agent_view=0
fi
# Git is strictly opt-in. Find roots with shell builtins and ask git once per
# distinct repository; no process is started for unrelated directories.
if [[ "$git_mode" == branch ]] && command -v git >/dev/null 2>&1; then
  # shellcheck disable=SC1091
  source "$SCRIPT_DIR/git-lib.sh"
  declare -A git_paths=() git_branches=()
  git_rows=''
  while IFS= read -r line; do
    [[ "$line" == P$sep* ]] || continue
    IFS="$sep" read -ra fields <<< "$line"
    [[ "${fields[7]:-}" != 1 && "${fields[8]:-}" != 1 && "${fields[9]:-}" != 1 ]] || continue
    directory=${fields[6]:-}
    [[ -n "$directory" ]] || continue
    if [[ -z ${git_paths[x$directory]+set} ]]; then
      canopy_git_root "$directory" || true
      git_paths[x$directory]=$CANOPY_GIT_ROOT
    fi
    root=${git_paths[x$directory]}
    [[ -n "$root" ]] || continue
    if [[ -z ${git_branches[x$root]+set} ]]; then
      canopy_git_branch "$root" || true
      git_branches[x$root]=$CANOPY_GIT_BRANCH
    fi
    branch=${git_branches[x$root]}
    [[ -z "$branch" ]] || git_rows+=$'\n'"G${sep}${fields[1]}${sep}${branch}"
  done <<< "$snapshot"
  snapshot+=$git_rows
fi
if [[ "$agent_view" == 1 && -d /proc/self ]] && command -v python3 >/dev/null 2>&1; then
  # Python is optional; its /proc walk avoids a full-system ps invocation.
  agent_records="$(python3 "$SCRIPT_DIR/../lib/agent-process.py" <<< "$snapshot")" || exit 1
  [[ -z "$agent_records" ]] || snapshot+=$'\n'"$agent_records"
else
  if [[ "$agents_enabled" == on && "$snapshot" == *"-hook${sep}"* ]]; then
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/../lib/agent-process.sh"
    while IFS= read -r line; do
      [[ $line == P$sep* && $line == *"-hook${sep}"* ]] || continue
      IFS="$sep" read -ra fields <<< "$line"
      kind=${fields[17]%-hook}
      if canopy_process_identity "${fields[16]:-}" "${fields[22]:-}" "${fields[23]:-}" "$kind"; then
        snapshot+=$'\n'"V${sep}${fields[1]}"
      fi
    done <<< "$snapshot"
  fi
  if [[ "$agent_view" == 1 ]]; then
    # Portable fallback for macOS/BSD and minimal Linux installations. Reuse
    # the cached snapshot from the hook-verification loop above when it ran;
    # otherwise this is the only ps invocation for this refresh.
    if ! declare -F canopy_ps_snapshot_lines >/dev/null 2>&1; then
      # shellcheck disable=SC1091
      source "$SCRIPT_DIR/../lib/agent-process.sh"
    fi
    canopy_ps_snapshot_lines >/dev/null || exit 1
    processes=${CANOPY_REPLY%$'\n'}
    [[ -z "$processes" ]] || snapshot+=$'\n'"$processes"
  fi
fi
# Byte-order string comparison for text_width's wide-character ranges, with
# the user's character set kept (LC_ALL would override both, so clear it).
ctype="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
LC_ALL='' LC_CTYPE="$ctype" LC_COLLATE=C awk -v switcher="$switcher" -v agent_view="$agent_view" -v now="$now" -v stable="${TMUX_CANOPY_STABLE:-0}" \
  -v nul="${TMUX_CANOPY_NUL:-0}" -v header="${TMUX_CANOPY_HEADER:-0}" -f "$SCRIPT_DIR/../lib/tree-render.awk" \
  "$state_file" - <<< "$snapshot"
