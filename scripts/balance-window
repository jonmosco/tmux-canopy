#!/usr/bin/env bash
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"

target_window="${1:-}"

balance_one_window() {
  local window_id="$1"
  [[ -n "$window_id" ]] || return 0

  local lock="tmux-canopy-balance-${window_id#@}"
  tmux wait-for -L "$lock" 2>/dev/null || return 0
  # shellcheck disable=SC2329
  trap 'tmux wait-for -U "$lock" 2>/dev/null || true' RETURN

  local snapshot
  snapshot="$(tmux display-message -p -t "$window_id" \
    "#{window_width}|#{window_zoomed_flag}|#{@tmux_canopy_drag_native}|#{@tmux_canopy_staged_sidebar}" 2>/dev/null)" || return 0

  local window_width zoomed drag_native staged
  IFS="|" read -r window_width zoomed drag_native staged <<< "$snapshot"
  [[ "$zoomed" == 0 ]] || return 0
  [[ "$drag_native" != 1 && -z "$staged" ]] || return 0

  local panes_data
  panes_data="$(tmux list-panes -t "$window_id" \
    -F "#{pane_id}|#{@tmux_canopy}|#{@tmux_canopy_slot}|#{pane_width}|#{@tmux_canopy_client}" 2>/dev/null)" || return 0

  local sidebar_pane="" sidebar_width="" sidebar_client="" content_count=0
  local pid canopy slot pwidth client
  while IFS="|" read -r pid canopy slot pwidth client; do
    [[ -n "$pid" ]] || continue
    if [[ "$canopy" == "1" || "$slot" == "1" ]]; then
      sidebar_pane="$pid"
      sidebar_width="$pwidth"
      sidebar_client="$client"
    else
      ((content_count++))
    fi
  done <<< "$panes_data"

  # Must have exactly one dock pane and exactly one content pane
  [[ -n "$sidebar_pane" && "$content_count" -eq 1 ]] || return 0

  if [[ -n "$sidebar_client" ]] && sidebar_transition_active "$sidebar_client"; then
    return 0
  fi

  local configured minimum maximum min_content runtime requested
  configured="$(tmux show-option -gqv @tmux-canopy-width 2>/dev/null || true)"
  minimum="$(tmux show-option -gqv @tmux-canopy-min-width 2>/dev/null || true)"
  maximum="$(tmux show-option -gqv @tmux-canopy-max-width 2>/dev/null || true)"
  min_content="$(tmux show-option -gqv @tmux-canopy-min-content-width 2>/dev/null || true)"
  runtime="$(tmux show-option -gqv @tmux_canopy_runtime_width 2>/dev/null || true)"
  : "${configured:=42}" "${minimum:=24}" "${maximum:=0}" "${min_content:=40}"

  requested="$configured"
  if [[ "$configured" =~ ^[1-9][0-9]*$ && "$runtime" =~ ^([1-9][0-9]*|[1-9][0-9]?%)$ ]]; then
    requested="$runtime"
  fi

  local target_width
  target_width="$(clamp_sidebar_width_for_total "$window_width" "$requested" "$minimum" "$maximum" "$min_content")" || return 0
  [[ -n "$target_width" ]] || return 0

  if [[ "$sidebar_width" != "$target_width" ]]; then
    tmux resize-pane -t "$sidebar_pane" -x "$target_width" 2>/dev/null || true
  fi
}

if [[ -n "$target_window" ]]; then
  balance_one_window "$target_window"
else
  while IFS= read -r win; do
    [[ -n "$win" ]] || continue
    balance_one_window "$win"
  done < <(tmux list-windows -a -F '#{window_id}' 2>/dev/null)
fi
