#!/usr/bin/env bash
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/buffer-lib.sh"
token="${1:-}"
rows="${FZF_PREVIEW_LINES:-12}"
[[ "$rows" =~ ^[1-9][0-9]{0,4}$ ]] || rows=12
export FZF_PREVIEW_LINES="$rows"

render() {
  local mode=''
  if [[ "${TMUX_PANE:-}" =~ ^%[0-9]+$ ]]; then
    mode="$(tmux show-option -pqv -t "$TMUX_PANE" @tmux_canopy_preview_mode 2>/dev/null || true)"
  fi
  if [[ ( "$mode" == agent || "$mode" == codex ) && "${TMUX_CANOPY_PREVIEW_EXPANDED:-0}" != 1 ]]; then
    case "$token" in P:*|Q:*|X:*|W:*) "$SCRIPT_DIR/agent-preview" "$token"; return ;; esac
  fi
  case "$token" in
    B:*|B2:*)
      buffer_decode_token "$token" || return 0
      name="$BUFFER_NAME"
      printf 'Buffer: %s\n\n' "${name//[[:cntrl:]]/ }"
      tmux show-buffer -b "$name" 2>/dev/null || true
      ;;
    X:*)
      rest="${token#X:}"; pid="${rest%%:*}"; pane="${rest#*:}"
      [[ "$pid" =~ ^[0-9]+$ && "$pane" =~ ^%[0-9]+$ ]] || return 0
      ps -p "$pid" -o pid=,comm=,%cpu=,%mem=,stat= 2>/dev/null || printf 'Process %s has exited.\n' "$pid"
      ((rows > 1)) || return 0
      FZF_PREVIEW_LINES="$((rows - 1))" "$SCRIPT_DIR/pane-preview" "$pane"
      ;;
    Q:*) "$SCRIPT_DIR/pane-preview" "${token#Q:}" ;;
    V:empty) printf 'No panes match the Tree filters.\nF / Ctrl-f changes filters; Ctrl-g searches everything.\n' ;;
    V:agents-empty) printf 'No Codex or Claude processes detected in tmux panes.\nPress 1 for Tree or Ctrl-g to search everything.\n' ;;
    V:*) printf 'Switch views with 1 (Tree), 2 (Processes), 3 (Buffers), or 4 (Agents).\n' ;;
    *) "$SCRIPT_DIR/tree-preview" "$token" ;;
  esac
}
if [[ "${TMUX_CANOPY_PREVIEW_EXPANDED:-0}" == 1 ]]; then
  render
else
  # Metadata and buffers obey the same fixed drawer budget as pane captures.
  render | awk -v rows="$rows" 'NR <= rows'
fi
