#!/usr/bin/env bash
# Read-only agent pane summary from tmux metadata and visible terminal text.
set -u
token="${1:-}"
case "$token" in
  P:%[0-9]*) pane="${token#P:}" ;;
  Q:%[0-9]*) pane="${token#Q:}" ;;
  X:*:%[0-9]*) pane="${token##*:}" ;;
  W:@[0-9]*:\$[0-9]*)
    window="${token#W:}"; window="${window%%:*}"
    panes="$(tmux list-panes -t "$window" -f '#{&&:#{!=:#{@tmux_canopy},1},#{!=:#{@tmux_canopy_slot},1}}' -F '#{pane_id}' 2>/dev/null)"
    if [[ "$panes" =~ ^%[0-9]+$ ]]; then pane="$panes"; else pane=''; fi
    ;;
  *) pane='' ;;
esac
if [[ ! "$pane" =~ ^%[0-9]+$ ]]; then
  printf 'Select an agent pane to see its terminal summary.\n'
  exit 0
fi
sep=$'\037'
clean=$'s/[\001-\037\177]/ /'
format="#{pane_id}$sep#{pane_pid}$sep#{${clean}:pane_current_command}$sep#{${clean}:pane_title}$sep#{${clean}:pane_current_path}$sep#{${clean}:session_name}$sep#{window_index}$sep#{${clean}:window_name}$sep#{@tmux_canopy}$sep#{@tmux_canopy_slot}$sep#{cursor_y}"
metadata="$(tmux display-message -p -t "$pane" "$format" 2>/dev/null)" || metadata=''
if [[ -z "$metadata" ]]; then printf 'Pane %s is no longer available.\n' "$pane"; exit 0; fi
IFS="$sep" read -r actual pid command title directory session index window sidebar slot cursor_y <<< "$metadata"
if [[ "$actual" != "$pane" ]]; then
  printf 'Pane %s is no longer available.\n' "$pane"; exit 0
fi
if [[ "$sidebar" == 1 || "$slot" == 1 ]]; then
  printf 'Select a content pane to inspect an agent.\n'; exit 0
fi
agent=''; kind=''
base=${command##*/}; base=${base%.exe}
case "$base" in
  codex) kind=codex ;;
  claude|claude-code) kind=claude ;;
  opencode|gemini|pi|omp|agy|crush|copilot|grok) kind=$base ;;
  hermes|hermes-agent) kind=hermes ;;
  antigravity) kind=agy ;;
  agent) kind=cursor-agent ;;
esac
if [[ -z "$kind" && "$pid" =~ ^[0-9]+$ && "$base" =~ ^(node|nodejs|python[0-9.]*|Python)$ ]]; then
  # A runtime is the agent only when it hosts one (Pi under node, Hermes under
  # python); its process name alone cannot say.
  # shellcheck disable=SC1091
  source "$(dirname "$0")/../lib/agent-process.sh"
  canopy_pane_agent "$pid" >/dev/null && kind=$CANOPY_REPLY
fi
if [[ -z "$kind" && "$pid" =~ ^[0-9]+$ ]]; then
  # Agents can be children of a pane shell. Resolve only descendants of that
  # pane, and prefer the closest matching process when there is more than one.
  kind="$(ps -eo pid=,ppid=,comm= 2>/dev/null | awk -v root="$pid" '
    function carrier(n) { sub(/^-/,"",n)
      return n ~ /^(sh|bash|zsh|fish|dash|ksh|mksh|tcsh|csh|nu|xonsh|elvish|pwsh|login|su|sudo|doas|env|nice|nohup|time|timeout|script|stdbuf|caffeinate|direnv|mise|asdf|nix|nix-shell|devbox|node|nodejs|bun|deno|npx|npm|pnpm|yarn|tsx|ts-node|python[0-9.]*|uv|uvx|pipx|poetry|ruby|bundle|cargo|make|just|bwrap|firejail|sandbox-exec|nono|fence|landrun|nsjail|minijail0|unshare|codex|claude|claude-code|opencode|gemini|pi|omp|agy|antigravity|agent|crush|copilot|grok)$/ }
    { parent[$1]=$2; name=$3; sub(/^.*\//,"",name); sub(/\.exe$/,"",name); comm[$1]=name
      if (name=="codex" || name=="opencode" || name=="gemini" || name=="pi" || name=="omp" || name=="agy" || name=="crush" || name=="copilot" || name=="grok") kind[$1]=name
      else if (name=="claude" || name=="claude-code") kind[$1]="claude"
      else if (name=="antigravity") kind[$1]="agy"
      else if (name=="agent") kind[$1]="cursor-agent" }
    END { best=129; for (p in kind) { q=p; for (depth=0;depth<128 && q>0;depth++) {
      # An editor or other foreground app between the pane and the agent
      # owns it (see agent_carrier in lib/tree-render.awk).
      if (q!=p && (q in comm) && !carrier(comm[q])) break
      if (q==root) { if (depth<best) { best=depth; result=kind[p] }; break }
      if (seen[p,q]++) break; q=parent[q] }
    } if (result!="") print result }')"
fi
case "$kind" in
  codex) agent='Codex' ;;
  claude) agent='Claude Code' ;;
  opencode) agent='OpenCode' ;;
  gemini) agent='Gemini CLI' ;;
  pi) agent='Pi' ;;
  omp) agent='Oh My Pi' ;;
  agy) agent='Antigravity' ;;
  cursor-agent) agent='cursor-agent' ;;
  crush) agent='Crush' ;;
  copilot) agent='Copilot CLI' ;;
  grok) agent='Grok Build' ;;
  hermes) agent='Hermes' ;;
esac
rows="${FZF_PREVIEW_LINES:-12}"
columns="${FZF_PREVIEW_COLUMNS:-42}"
[[ "$rows" =~ ^[1-9][0-9]{0,4}$ ]] || rows=12
[[ "$columns" =~ ^[1-9][0-9]{0,4}$ ]] || columns=42
if [[ -z "$agent" ]]; then
  printf 'Terminal · no agent detected\n'
  if ((rows > 1)); then
    FZF_PREVIEW_LINES=$((rows - 1)) "${BASH_SOURCE[0]%/*}/pane-preview" "$pane"
  fi
  exit 0
fi
used=0
printf '%s · %s:%s %s · %s\n' "$agent" "$session" "$index" "$window" "$pane"
((used+=1))
if [[ -n "$title" && "$title" != "$command" ]]; then
  printf 'Title: %s\n' "$title"
  ((used+=1))
fi
# shellcheck disable=SC1091
source "${BASH_SOURCE[0]%/*}/path-lib.sh"
canopy_home_path directory
printf 'Directory: %s\n' "$directory"
((used+=1))
reported=0
infer_request=1
if [[ "$pid" =~ ^[0-9]+$ ]]; then
  # shellcheck disable=SC1091
  source "$(dirname "$0")/../lib/agent-process.sh"
  format="#{@tmux_canopy_agent_source}$sep#{@tmux_canopy_agent_pane_pid}$sep#{@tmux_canopy_agent_session}$sep#{@tmux_canopy_agent_updated}$sep#{@tmux_canopy_agent_process_pid}$sep#{@tmux_canopy_agent_process_birth}$sep#{@tmux_canopy_agent_status}$sep#{@tmux_canopy_agent_tool}$sep#{@tmux_canopy_agent_summary}$sep#{@tmux_canopy_agent_command}"
  report_raw="$(tmux display-message -p -t "$pane" "$format" 2>/dev/null)" || report_raw=''
  IFS="$sep" read -r report_source report_pid report_session report_updated report_process report_birth report_status report_tool report_summary report_command <<< "$report_raw"
  if [[ "$report_source" == "$kind-hook" && "$report_pid" == "$pid" && -n "$report_session" && "$report_updated" =~ ^[0-9]{1,12}$ ]] &&
     canopy_process_identity "$pid" "$report_process" "$report_birth" "$kind"; then
    now="$(date +%s)"
    age=$((now - 10#$report_updated))
    if ((age >= 0 && age <= 900)); then
      case "$report_status" in
        ready) label='Ready' ;;
        working) label='Working' ;;
        needs-input) label='Approval requested (hook report)' ;;
        turn-ended) label='Turn ended' ;;
        interrupted) label='Interrupted' ;;
        session-ended) label='Session ended' ;;
        *) label='Unknown' ;;
      esac
      if [[ "$kind" == opencode ]]; then source_name="$agent plugin (session association unverified)"; else source_name="$agent lifecycle hook"; fi
      printf 'Source: %s · reported %ss ago\n' "$source_name" "$age"
      printf 'Status: %s\n' "$label"
      ((used+=2))
      if [[ "$report_status" == needs-input ]]; then
        if [[ -n "$report_tool" ]]; then printf 'Tool: %s\n' "$report_tool"; ((used+=1)); fi
        if [[ -n "$report_summary" ]]; then printf 'Request: %s\n' "$report_summary"; ((used+=1)); fi
        if [[ -n "$report_command" ]]; then printf 'Command: %s\n' "$report_command"; ((used+=1)); fi
      fi
      reported=1
      infer_request=0
    fi
    if ((reported == 0)); then
      if [[ "$kind" == opencode ]]; then source_name="$agent plugin (session association unverified)"; else source_name="$agent lifecycle hook"; fi
      printf 'Source: %s · last report %ss ago\n' "$source_name" "$age"
      ((used+=1))
      reported=1
      infer_request=0
    fi
  fi
fi
if ((reported == 0)); then
  printf 'Source: visible terminal text · snapshot only\n'
  ((used+=1))
fi
# Capture the current screen only. History can contain prompts already answered.
# Hook reports provide state; screen wording is only interpreted when no fresh
# or stale report can establish it. The active cursor row is still available
# for request inference, but omitted from the terminal tail so the agent input
# prompt does not displace useful output.
available=$((rows - used))
((available > 0)) || exit 0
cursor_line=0
[[ "$cursor_y" =~ ^[0-9]+$ ]] && cursor_line=$((cursor_y + 1))
tmux capture-pane -p -t "$pane" 2>/dev/null | awk \
  -v limit="$available" -v infer="$infer_request" -v cursor="$cursor_line" '
  function clipped(value) {
    gsub(/^[ \t]+|[ \t]+$/, "", value)
    if (value=="") return ""
    return value
  }
  { line[++n]=$0 }
  END {
    while (n>0 && line[n] ~ /^[ \t]*$/) n--
    request=""
    first=n-11; if (first<1) first=1
    if (infer) {
      for (i=first;i<=n;i++) {
        value=tolower(line[i])
        if (value ~ /(permission needed|needs your (approval|permission)|do you want to (run|allow|approve|proceed|trust)|would you like to (run|allow|approve|proceed)|press (enter|y) to (approve|confirm)|allow (once|always)|yes, allow|trust the files in this folder)/) request=clipped(line[i])
      }
      if (request!="" && limit>=4) {
        print "Possible input requested (unverified):"
        print "  " request
        limit-=2
      } else if (limit>=3) {
        print "No clear request visible in the current screen."
        limit--
      }
      if (limit>=3) { print ""; limit-- }
    }
    if (limit>0) {
      print "Recent screen:"
      limit--
      count=0
      for (i=n;i>=1 && count<limit;i--) {
        value=clipped(line[i])
        if (i!=cursor && value!="") recent[++count]=value
      }
      for (i=count;i>=1;i--) print "  " recent[i]
    }
  }
'
