#!/usr/bin/env bash
# Read-only agent pane summary: fixed field card or all-sessions agent list.
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
list_mode=0
if [[ "${1:-}" == --list ]]; then
  list_mode=1
  shift
fi
token="${1:-}"
rows="${FZF_PREVIEW_LINES:-12}"
columns="${FZF_PREVIEW_COLUMNS:-42}"
[[ "$rows" =~ ^[1-9][0-9]{0,4}$ ]] || rows=12
[[ "$columns" =~ ^[1-9][0-9]{0,4}$ ]] || columns=42
sep=$'\037'
clean=$'s/[\001-\037\177]/ /'

if ((list_mode)); then
  # shellcheck disable=SC1091
  source "$SCRIPT_DIR/../lib/agent-process.sh"
  cfg_target=()
  [[ "${TMUX_PANE:-}" =~ ^%[0-9]+$ ]] && cfg_target=(-t "$TMUX_PANE")
  cfg_fmt="CFG${sep}#{@tmux-canopy-theme}${sep}#{@tmux_canopy_icon_theme}${sep}#{@tmux_canopy_notifications}${sep}#{@tmux_canopy_target}"
  pane_fmt="P${sep}#{pane_id}${sep}#{pane_pid}${sep}#{${clean}:pane_current_command}${sep}#{${clean}:session_name}${sep}#{window_index}${sep}#{pane_index}${sep}#{pane_dead}${sep}#{@tmux_canopy}${sep}#{@tmux_canopy_slot}${sep}#{@tmux_canopy_notice_pane_activity}${sep}#{@tmux_canopy_notice_pane_bell}${sep}#{@tmux_canopy_notice_pane_silence}${sep}#{@tmux_canopy_agent_source}${sep}#{@tmux_canopy_agent_pane_pid}${sep}#{${clean}:@tmux_canopy_agent_session}${sep}#{@tmux_canopy_agent_updated}${sep}#{@tmux_canopy_agent_process_pid}${sep}#{${clean}:@tmux_canopy_agent_process_birth}${sep}#{@tmux_canopy_agent_status}${sep}#{${clean}:@tmux_canopy_agent_summary}${sep}#{${clean}:@tmux_canopy_agent_command}${sep}#{${clean}:@tmux_canopy_agent_subagents}"
  snapshot="$(tmux display-message -p "${cfg_target[@]}" "$cfg_fmt" \; list-panes -a -F "$pane_fmt" 2>/dev/null)" || snapshot=''
  theme='ansi' icons='unicode' notices='' active_target=''
  printf -v now '%(%s)T' -1
  declare -A seen_panes=()
  {
    while IFS="$sep" read -r tag f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18 f19 f20 f21 f22; do
      if [[ "$tag" == CFG ]]; then
        [[ -n "$f1" ]] && theme="$f1"
        [[ -n "$f2" ]] && icons="$f2"
        notices="$f3"
        active_target="$f4"
        printf 'CFG\037%s\037%s\n' "$theme" "$icons"
        continue
      fi
      [[ "$tag" == P ]] || continue
      p="$f1" pid="$f2" command="$f3" session="$f4" index="$f5" pane_idx="$f6" dead="$f7" sidebar="$f8" slot="$f9"
      activity="$f10" bell="$f11" silence="$f12"
      report_source="$f13" report_pid="$f14" report_session="$f15" report_updated="$f16"
      report_process="$f17" report_birth="$f18" report_status="$f19" report_summary="$f20" report_command="$f21" report_subagents="$f22"
      [[ "$sidebar" != 1 && "$slot" != 1 && "$dead" != 1 && -z "${seen_panes[$p]:-}" ]] || continue
      seen_panes["$p"]=1
      if [[ ! "$pid" =~ ^[0-9]+$ ]] || ! canopy_resolve_pane_agent "$pid" "$command" >/dev/null; then
        continue
      fi
      kind="$CANOPY_REPLY"
      agent="$kind"
      canopy_agent_label "$kind" >/dev/null && agent="$CANOPY_REPLY"
      state_code='detected'
      brief='Detected'
      if [[ "$report_source" == "$kind-hook" && "$report_pid" == "$pid" && -n "$report_session" && "$report_updated" =~ ^[0-9]{1,12}$ ]] &&
         canopy_process_identity "$pid" "$report_process" "$report_birth" "$kind"; then
        age=$((now - 10#$report_updated))
        if ((age >= 0 && age <= 900)); then
          sub_need=0 sub_work=0
          if [[ -n "$report_subagents" ]]; then
            IFS=';' read -ra sub_items <<< "$report_subagents"
            for sub_item in "${sub_items[@]}"; do
              IFS=',' read -r _sid _stype sub_state sub_updated _stool <<< "$sub_item"
              if [[ "$sub_updated" =~ ^[0-9]+$ && "$sub_state" != 'done' ]]; then
                sub_age=$((now - 10#$sub_updated))
                if ((sub_age >= 0 && sub_age <= 900)); then
                  [[ "$sub_state" == needs-input ]] && sub_need=1
                  [[ "$sub_state" == working ]] && sub_work=1
                fi
              fi
            done
          fi
          case "$report_status" in
            needs-input)
              state_code='needs-input'
              if [[ -n "$report_command" ]]; then brief="Needs input: $report_command"
              elif [[ -n "$report_summary" ]]; then brief="Needs input: $report_summary"
              else brief='Needs input'; fi
              ;;
            interrupted)
              state_code='interrupted'; brief='Interrupted' ;;
            working)
              if ((sub_need)); then state_code='needs-input'; brief='Needs input (subagent)'
              else state_code='working'; brief='Working'; fi ;;
            ready|turn-ended|session-ended)
              if ((sub_need)); then state_code='needs-input'; brief='Needs input (subagent)'
              elif ((sub_work)); then state_code='working'; brief='Working'
              elif [[ "$report_status" == ready ]]; then state_code='ready'; brief='Ready'
              elif [[ "$report_status" == turn-ended ]]; then state_code='turn-ended'; brief='Turn ended'
              else state_code='session-ended'; brief='Session ended'; fi ;;
            *)
              state_code='unknown'; brief='Unknown' ;;
          esac
        else
          state_code='stale'; brief='Stale report'
        fi
      fi
      notice_kind=''
      if [[ "$notices" != none ]]; then
        if [[ "$bell" == 1 ]]; then notice_kind='bell'
        elif [[ "$activity" == 1 ]]; then notice_kind='activity'
        elif [[ "$silence" == 1 ]]; then notice_kind='silence'
        fi
      fi
      is_active=0
      [[ "$p" == "$active_target" ]] && is_active=1
      printf 'ROW\037%s\037%s\037%s\037%s\037%s\037%s\n' "$session:$index.$pane_idx" "$agent" "$state_code" "$brief" "$notice_kind" "$is_active"
    done <<< "$snapshot"
  } | awk -F '\037' -v limit="$rows" -v width="$columns" '
    BEGIN { theme="ansi"; icons="unicode" }
    $1 == "CFG" { theme=$2; icons=$3; next }
    $1 == "ROW" {
      loc[++n]=$2; agent[n]=$3; state[n]=$4; brief[n]=$5; notice[n]=$6; active[n]=$7
    }
    END {
      if (theme!="mono") {
        reset="\033[0m"; bold="\033[1m"; dim="\033[38;5;245m"
        if (ENVIRON["CANOPY_COLOR_MUTED_ANSI"] != "") dim=ENVIRON["CANOPY_COLOR_MUTED_ANSI"]
        attention="\033[1;33m"; working="\033[1;36m"; green="\033[32m"
      }
      inset=(width>=24 ? " " : "")
      content_width=width-2*length(inset)
      if (content_width<1) content_width=1
      if (n==0) {
        print inset dim "No active agents across sessions." reset
        exit
      }
      sep=(icons=="ascii" ? " | " : " · ")
      sep_len=(icons=="ascii" ? 3 : 3)
      more=(icons=="ascii" ? "~" : "…")
      for (i=1; i<=n && i<=limit; i++) {
        st=state[i]
        if (st=="needs-input" || st=="interrupted") { glyph="!"; gstyle=attention }
        else if (st=="working") { glyph=(icons=="ascii" ? "+" : "▷"); gstyle=working }
        else if (st=="ready" || st=="turn-ended" || st=="session-ended") { glyph=(icons=="ascii" ? "d" : "✓"); gstyle=dim }
        else { glyph=(icons=="ascii" ? "o" : "○"); gstyle=dim }

        nt=notice[i]; nglyph=""; nwidth=0
        if (nt=="bell") { nglyph=(icons=="ascii" ? "B" : (icons=="nerdfont" ? "" : "🔔")); nwidth=(nglyph=="🔔" ? 2 : 1) }
        else if (nt=="silence") { nglyph=(icons=="ascii" ? "~" : "◷"); nwidth=1 }
        else if (nt=="activity") { nglyph=(icons=="ascii" ? "*" : "●"); nwidth=1 }

        avail=content_width-(nwidth>0 ? nwidth+1 : 0)
        if (avail<1) avail=1
        prefix_len=2+length(loc[i])+2
        body_budget=avail-prefix_len
        ag=agent[i]; br=brief[i]
        bstyle=(st=="needs-input" || st=="interrupted" ? "" : dim)
        if (body_budget<=0) {
          body_colored=""; used_len=2+length(loc[i])
          gap_str=""
        } else {
          gap_str="  "
          if (length(ag) + sep_len + length(br) <= body_budget) {
            body_colored=dim ag sep reset bstyle br reset
            used_len=prefix_len + length(ag) + sep_len + length(br)
          } else if (body_budget > length(ag) + sep_len + 1) {
            keep=body_budget - length(ag) - sep_len - 1
            br_clip=substr(br, 1, keep)
            body_colored=dim ag sep reset bstyle br_clip more reset
            used_len=prefix_len + length(ag) + sep_len + keep + 1
          } else if (body_budget >= length(ag)) {
            body_colored=dim ag reset
            used_len=prefix_len + length(ag)
          } else {
            ag_clip=substr(ag, 1, body_budget)
            body_colored=dim ag_clip reset
            used_len=prefix_len + length(ag_clip)
          }
        }
        lstyle=(active[i]=="1" ? green : bold)
        line_out=inset gstyle glyph reset " " lstyle loc[i] reset gap_str body_colored
        if (nwidth>0) {
          pad=avail-used_len
          if (pad<0) pad=0
          line_out=line_out sprintf("%*s", pad+1, "") attention nglyph reset
        }
        print line_out
      }
    }
  '
  exit 0
fi

case "$token" in
  P:%[0-9]*|DIR:%[0-9]*) pane="${token#*:}" ;;
  Q:%[0-9]*) pane="${token#Q:}" ;;
  X:*:%[0-9]*) pane="${token##*:}" ;;
  W:@[0-9]*:\$[0-9]*)
    window="${token#W:}"; window="${window%%:*}"
    panes="$(tmux list-panes -t "$window" -f '#{&&:#{!=:#{@tmux_canopy},1},#{!=:#{@tmux_canopy_slot},1}}' -F '#{pane_id}' 2>/dev/null)"
    if [[ "$panes" =~ ^%[0-9]+$ ]]; then pane="$panes"; else pane=''; fi
    ;;
  *) pane='' ;;
esac
if [[ ! "$pane" =~ ^%[0-9]+$ ]]; then
  printf 'Select an agent pane to see its terminal summary.\n'
  exit 0
fi
sep=$'\037'
clean=$'s/[\001-\037\177]/ /'
format="#{pane_id}$sep#{pane_pid}$sep#{${clean}:pane_current_command}$sep#{${clean}:pane_current_path}$sep#{${clean}:session_name}$sep#{window_index}$sep#{${clean}:window_name}$sep#{@tmux_canopy}$sep#{@tmux_canopy_slot}$sep#{@tmux-canopy-theme}$sep#{@tmux_canopy_icon_theme}$sep#{@tmux-canopy-git-context}$sep#{@tmux_canopy_agent_source}$sep#{@tmux_canopy_agent_pane_pid}$sep#{@tmux_canopy_agent_session}$sep#{@tmux_canopy_agent_updated}$sep#{@tmux_canopy_agent_process_pid}$sep#{@tmux_canopy_agent_process_birth}$sep#{@tmux_canopy_agent_status}$sep#{@tmux_canopy_agent_summary}$sep#{@tmux_canopy_agent_command}"
metadata="$(tmux display-message -p -t "$pane" "$format" 2>/dev/null)" || metadata=''
if [[ -z "$metadata" ]]; then printf 'Pane %s is no longer available.\n' "$pane"; exit 0; fi
IFS="$sep" read -r actual pid command directory session index window sidebar slot theme icons git_mode report_source report_pid report_session report_updated report_process report_birth report_status report_summary report_command <<< "$metadata"
if [[ "$actual" != "$pane" ]]; then
  printf 'Pane %s is no longer available.\n' "$pane"; exit 0
fi
if [[ "$sidebar" == 1 || "$slot" == 1 ]]; then
  printf 'Select a content pane to inspect an agent.\n'; exit 0
fi
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/agent-process.sh"
kind=''
agent=''
if [[ "$pid" =~ ^[0-9]+$ ]]; then
  canopy_resolve_pane_agent "$pid" "$command" >/dev/null && kind=$CANOPY_REPLY
fi
[[ -n "$kind" ]] && canopy_agent_label "$kind" >/dev/null && agent=$CANOPY_REPLY
rows="${FZF_PREVIEW_LINES:-12}"
columns="${FZF_PREVIEW_COLUMNS:-42}"
[[ "$rows" =~ ^[1-9][0-9]{0,4}$ ]] || rows=12
[[ "$columns" =~ ^[1-9][0-9]{0,4}$ ]] || columns=42
state='Detected'
trust='snapshot only'
infer_request=1
request=''
request_command=''
if [[ -z "$agent" ]]; then
  agent='Terminal'
  state='No agent'
  trust=''
  infer_request=0
fi
if [[ -n "$kind" && "$pid" =~ ^[0-9]+$ ]]; then
  if [[ "$report_source" == "$kind-hook" && "$report_pid" == "$pid" && -n "$report_session" && "$report_updated" =~ ^[0-9]{1,12}$ ]] &&
     canopy_process_identity "$pid" "$report_process" "$report_birth" "$kind"; then
    printf -v now '%(%s)T' -1
    age=$((now - 10#$report_updated))
    if [[ "$kind" == opencode ]]; then trust="plugin · ${age}s"; else trust="lifecycle hook · ${age}s"; fi
    infer_request=0
    if ((age >= 0 && age <= 900)); then
      case "$report_status" in
        ready) state='Ready' ;;
        working) state='Working' ;;
        needs-input) state='Needs input' ;;
        turn-ended) state='Turn ended' ;;
        interrupted) state='Interrupted' ;;
        session-ended) state='Session ended' ;;
        *) state='Unknown' ;;
      esac
      if [[ "$report_status" == needs-input ]]; then
        request=$report_summary
        request_command=$report_command
      fi
    else
      state='Stale report'
    fi
  fi
fi
git_line=''
if [[ "$git_mode" == branch ]] && command -v git >/dev/null 2>&1; then
  # shellcheck disable=SC1091
  source "$SCRIPT_DIR/git-lib.sh"
  if canopy_git_root "$directory" && canopy_git_branch "$CANOPY_GIT_ROOT"; then
    repo=${CANOPY_GIT_ROOT##*/}
    if [[ "$icons" == ascii ]]; then
      git_line="$repo [git:$CANOPY_GIT_BRANCH]"
    else
      git_line="$repo ⎇ $CANOPY_GIT_BRANCH"
    fi
    git_budget=$((columns - (columns >= 24 ? 2 : 0) - ${#git_line}))
    if ((git_budget > 0)) && canopy_git_dirty "$CANOPY_GIT_ROOT" "$icons" "$git_budget"; then
      git_line+="$CANOPY_GIT_DIRTY"
    fi
  fi
fi
# shellcheck disable=SC1091
source "$SCRIPT_DIR/path-lib.sh"
canopy_home_path directory
place="$session:$index $window"
active_here=0
if [[ "${TMUX_PANE:-}" =~ ^%[0-9]+$ ]]; then
  active="$(tmux show-option -pqv -t "$TMUX_PANE" @tmux_canopy_target 2>/dev/null || true)"
  [[ "$active" == "$pane" ]] && active_here=1
fi
# Only possible, explicitly unverified request hints need a screen capture.
# Text travels through the environment: awk -v would interpret backslashes in
# paths and proposed commands. fzf still owns terminal-cell clipping.
if ((infer_request)); then
  tmux capture-pane -p -t "$pane" 2>/dev/null
fi |
  CANOPY_PREVIEW_AGENT="$agent" CANOPY_PREVIEW_STATE="$state" \
  CANOPY_PREVIEW_TRUST="$trust" CANOPY_PREVIEW_PROCESS="$command" \
  CANOPY_PREVIEW_REQUEST="$request" CANOPY_PREVIEW_COMMAND="$request_command" \
  CANOPY_PREVIEW_DIRECTORY="$directory" CANOPY_PREVIEW_GIT="$git_line" \
  CANOPY_PREVIEW_PLACE="$place" \
  awk -v limit="$rows" -v infer="$infer_request" -v active="$active_here" \
    -v width="$columns" -v theme="$theme" -v icons="$icons" '
  function clipped(value) {
    gsub(/^[ \t]+|[ \t]+$/, "", value)
    return value
  }
  function emit(value, style) {
    if (used >= limit) return
    if (value=="") print ""
    else print inset style value reset
    used++
  }
  function req_lines() {
    return (infer && request!="") + (request!="") + (command!="")
  }
  { line[++n]=$0 }
  END {
    if (theme!="mono") {
      reset="\033[0m"; bold="\033[1m"; dim="\033[38;5;245m"
      if (ENVIRON["CANOPY_COLOR_MUTED_ANSI"] != "") dim=ENVIRON["CANOPY_COLOR_MUTED_ANSI"]
      attention="\033[1;33m"; working="\033[1;36m"; green="\033[32m"
    }
    state=ENVIRON["CANOPY_PREVIEW_STATE"]
    style=bold
    if (state=="Needs input" || state=="Interrupted") style=attention
    else if (state=="Working") style=working
    else if (state=="Detected" || state=="Stale report" || state=="Unknown") style=dim
    inset=(width>=24 ? " " : "")
    content_width=width-2*length(inset)
    heading=(state=="Needs input" || state=="Interrupted" ? "! " : "") state
    agent=ENVIRON["CANOPY_PREVIEW_AGENT"]
    gap=content_width-length(heading)-length(agent)
    if (gap>=2)
      emit(style heading reset sprintf("%*s",gap,"") dim agent, "")
    else
      emit(style heading reset " · " dim agent, "")
    request=ENVIRON["CANOPY_PREVIEW_REQUEST"]
    command=ENVIRON["CANOPY_PREVIEW_COMMAND"]
    while (n>0 && clipped(line[n])=="") n--
    if (infer) {
      first=n-11; if (first<1) first=1
      for (i=first;i<=n;i++) {
        value=tolower(line[i])
        if (value ~ /(permission needed|needs your (approval|permission)|do you want to (run|allow|approve|proceed|trust)|would you like to (run|allow|approve|proceed)|press (enter|y) to (approve|confirm)|allow (once|always)|yes, allow|trust the files in this folder)/) request=clipped(line[i])
      }
    }
    trust=ENVIRON["CANOPY_PREVIEW_TRUST"]
    process=ENVIRON["CANOPY_PREVIEW_PROCESS"]
    directory=ENVIRON["CANOPY_PREVIEW_DIRECTORY"]
    git=ENVIRON["CANOPY_PREVIEW_GIT"]
    place=ENVIRON["CANOPY_PREVIEW_PLACE"]
    # Short drawers keep a present request/command ahead of trust and place.
    need=req_lines()
    req_cost=need
    if (need>0 && limit-used > need) req_cost++
    identity_budget=limit-used-req_cost
    if (identity_budget<0) identity_budget=0
    if (identity_budget>0 && trust!="") { emit(trust, dim); identity_budget-- }
    else if (identity_budget>0 && state=="No agent" && process!="") {
      emit(process, dim); identity_budget--
    }
    if (identity_budget>0 && directory!="") { emit(directory, dim); identity_budget-- }
    if (identity_budget>0 && git!="") { emit(git, dim); identity_budget-- }
    if (identity_budget>0 && place!="") {
      if (active) {
        marker=(icons=="ascii" ? "> " : "● ")
        emit(green marker reset dim place, "")
      } else emit(place, dim)
    }
    if (need>0 && used < limit) {
      if (limit-used > need) emit("", "")
      if (infer && request!="") emit("Possible input requested (unverified):", dim)
      if (request!="") emit(request, "")
      if (command!="") emit(attention (icons=="ascii" ? "| " : "│ ") reset command, "")
    }
  }
'
