#!/usr/bin/env bash
# Read-only agent pane summary from tmux metadata and visible terminal text.
set -u
token="${1:-}"
case "$token" in
  P:%[0-9]*) pane="${token#P:}" ;;
  Q:%[0-9]*) pane="${token#Q:}" ;;
  X:*:%[0-9]*) pane="${token##*:}" ;;
  W:@[0-9]*:\$[0-9]*)
    window="${token#W:}"; window="${window%%:*}"
    panes="$(tmux list-panes -t "$window" -f '#{&&:#{!=:#{@tmux_canopy},1},#{!=:#{@tmux_canopy_slot},1}}' -F '#{pane_id}' 2>/dev/null)"
    if [[ "$panes" =~ ^%[0-9]+$ ]]; then pane="$panes"; else pane=''; fi
    ;;
  *) pane='' ;;
esac
if [[ ! "$pane" =~ ^%[0-9]+$ ]]; then
  printf 'Select an agent pane to see its terminal summary.\n'
  exit 0
fi
sep=$'\037'
clean=$'s/[\001-\037\177]/ /'
format="#{pane_id}$sep#{pane_pid}$sep#{${clean}:pane_current_command}$sep#{${clean}:pane_title}$sep#{${clean}:pane_current_path}$sep#{${clean}:session_name}$sep#{window_index}$sep#{${clean}:window_name}$sep#{@tmux_canopy}$sep#{@tmux_canopy_slot}"
metadata="$(tmux display-message -p -t "$pane" "$format" 2>/dev/null)" || metadata=''
if [[ -z "$metadata" ]]; then printf 'Pane %s is no longer available.\n' "$pane"; exit 0; fi
IFS="$sep" read -r actual pid command title directory session index window sidebar slot <<< "$metadata"
if [[ "$actual" != "$pane" ]]; then
  printf 'Pane %s is no longer available.\n' "$pane"; exit 0
fi
if [[ "$sidebar" == 1 || "$slot" == 1 ]]; then
  printf 'Select a content pane to inspect an agent.\n'; exit 0
fi
agent=''; kind=''
base=${command##*/}; base=${base%.exe}
case "$base" in
  codex) kind=codex ;;
  claude|claude-code) kind=claude ;;
  opencode|gemini|pi|omp|agy) kind=$base ;;
  antigravity) kind=agy ;;
esac
if [[ -z "$kind" && "$pid" =~ ^[0-9]+$ ]]; then
  # Agents can be children of a pane shell. Resolve only descendants of that
  # pane, and prefer the closest matching process when there is more than one.
  kind="$(ps -eo pid=,ppid=,comm= 2>/dev/null | awk -v root="$pid" '
    { parent[$1]=$2; name=$3; sub(/^.*\//,"",name); sub(/\.exe$/,"",name)
      if (name=="codex" || name=="opencode" || name=="gemini" || name=="pi" || name=="omp" || name=="agy") kind[$1]=name
      else if (name=="claude" || name=="claude-code") kind[$1]="claude"
      else if (name=="antigravity") kind[$1]="agy" }
    END { best=129; for (p in kind) { q=p; for (depth=0;depth<128 && q>0;depth++) {
      if (q==root) { if (depth<best) { best=depth; result=kind[p] }; break }
      if (seen[p,q]++) break; q=parent[q] }
    } if (result!="") print result }')"
fi
case "$kind" in
  codex) agent='Codex' ;;
  claude) agent='Claude Code' ;;
  opencode) agent='OpenCode' ;;
  gemini) agent='Gemini CLI' ;;
  pi) agent='Pi' ;;
  omp) agent='Oh My Pi' ;;
  agy) agent='Antigravity' ;;
esac
if [[ -z "$agent" ]]; then
  printf 'No supported agent process found in pane %s.\n' "$pane"
  printf 'Select a pane running an agent, or press i for terminal preview.\n'
  exit 0
fi
columns="${FZF_PREVIEW_COLUMNS:-42}"
[[ "$columns" =~ ^[1-9][0-9]{0,3}$ ]] || columns=42
printf '%s · %s:%s %s · %s\n' "$agent" "$session" "$index" "$window" "$pane"
[[ -z "$title" || "$title" == "$command" ]] || printf 'Title: %s\n' "$title"
printf 'Directory: %s\n' "$directory"
if [[ "$pid" =~ ^[0-9]+$ ]]; then
  # shellcheck disable=SC1091
  source "$(dirname "$0")/../lib/agent-process.sh"
  format="#{@tmux_canopy_agent_source}$sep#{@tmux_canopy_agent_pane_pid}$sep#{@tmux_canopy_agent_session}$sep#{@tmux_canopy_agent_updated}$sep#{@tmux_canopy_agent_process_pid}$sep#{@tmux_canopy_agent_process_birth}$sep#{@tmux_canopy_agent_status}$sep#{@tmux_canopy_agent_tool}$sep#{@tmux_canopy_agent_summary}$sep#{@tmux_canopy_agent_command}"
  report_raw="$(tmux display-message -p -t "$pane" "$format" 2>/dev/null)" || report_raw=''
  IFS="$sep" read -r report_source report_pid report_session report_updated report_process report_birth report_status report_tool report_summary report_command <<< "$report_raw"
  if [[ "$report_source" == "$kind-hook" && "$report_pid" == "$pid" && -n "$report_session" && "$report_updated" =~ ^[0-9]{1,12}$ ]] &&
     canopy_process_identity "$pid" "$report_process" "$report_birth" "$kind"; then
    now="$(date +%s)"
    age=$((now - 10#$report_updated))
    if ((age >= 0 && age <= 900)); then
      case "$report_status" in
        ready) label='Ready' ;;
        working) label='Working' ;;
        needs-input) label='Approval requested (hook report)' ;;
        turn-ended) label='Turn ended' ;;
        interrupted) label='Interrupted' ;;
        session-ended) label='Session ended' ;;
        *) label='Unknown' ;;
      esac
      if [[ "$kind" == opencode ]]; then source_name="$agent plugin (session association unverified)"; else source_name="$agent lifecycle hook"; fi
      printf 'Source: %s · reported %ss ago\n' "$source_name" "$age"
      printf 'Status: %s\n' "$label"
      if [[ "$report_status" == needs-input ]]; then
        [[ -z "$report_tool" ]] || printf 'Tool: %s\n' "$report_tool"
        [[ -z "$report_summary" ]] || printf 'Request: %s\n' "$report_summary"
        [[ -z "$report_command" ]] || printf 'Command: %s\n' "$report_command"
      fi
      exit 0
    fi
    if [[ "$kind" == opencode ]]; then source_name="$agent plugin (session association unverified)"; else source_name="$agent lifecycle hook"; fi
    printf 'Source: %s · last report %ss ago\n' "$source_name" "$age"
    printf 'Status: Unknown (report stale)\n'
    exit 0
  fi
fi
printf 'Source: visible terminal text · snapshot only\n\n'
# Capture the current screen only. History can contain prompts already answered.
# The label is deliberately tentative: terminal text cannot prove request state.
tmux capture-pane -p -t "$pane" 2>/dev/null | awk -v width="$columns" '
  function wrap(value,    take,part) {
    gsub(/^[ \t]+|[ \t]+$/, "", value)
    if (value=="") return
    while (length(value)>width-2) {
      take=width-2; part=substr(value,1,take)
      if (part ~ / /) { sub(/ [^ ]*$/, "", part); if (part!="") take=length(part) }
      print "  " substr(value,1,take)
      value=substr(value,take+1); sub(/^[ \t]+/, "", value)
    }
    print "  " value
  }
  { line[++n]=$0 }
  END {
    while (n>0 && line[n] ~ /^[ \t]*$/) n--
    first=n-11; if (first<1) first=1
    request=""
    for (i=first;i<=n;i++) {
      value=tolower(line[i])
      if (value ~ /(permission needed|needs your (approval|permission)|do you want to (run|allow|approve|proceed|trust)|would you like to (run|allow|approve|proceed)|press (enter|y) to (approve|confirm)|allow (once|always)|yes, allow|trust the files in this folder)/) request=line[i]
    }
    if (request!="") { print "Possible input requested (unverified):"; wrap(request) }
    else print "No clear request visible in the current screen."
    print ""; print "Recent screen:"
    first=n-5; if (first<1) first=1
    for (i=first;i<=n;i++) if (line[i] !~ /^[ \t]*$/) wrap(line[i])
  }
'
