#!/usr/bin/env bash
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/launch-lib.sh"
state_file="${TMUX_CANOPY_STATE:-}"
export TMUX_CANOPY_STABLE=0 TMUX_CANOPY_NUL=0
# Old live UIs retain newline framing; only new UIs opt into NUL records.
[[ "${TMUX_CANOPY_RECORD_FORMAT:-}" == nul ]] && TMUX_CANOPY_NUL=1
for argument in "$@"; do
  case "$argument" in
    --stable) TMUX_CANOPY_STABLE=1 ;;
    --read0) TMUX_CANOPY_NUL=1 ;;
  esac
done

render_source() {
  set -o pipefail
  local view=tree kind value _rest
  [[ -r "$state_file" ]] || return 1
  while IFS=$'\t' read -r kind value _rest; do
    if [[ "$kind" == VIEW ]]; then view="$value"; break; fi
  done < "$state_file"
  if [[ "$view" == agents ]]; then
    if [[ "$(tmux show-option -gqv @tmux-canopy-agents 2>/dev/null || true)" == on ]]; then
      export TMUX_CANOPY_HEADER=1
      exec "$SCRIPT_DIR/tree-source" --agents
    fi
    view=tree
  fi
  if [[ "$view" != processes && "$view" != buffers ]]; then
    export TMUX_CANOPY_HEADER=1
    exec "$SCRIPT_DIR/tree-source"
  fi
  {
    "$SCRIPT_DIR/view-header" || return
    case "$view" in
      processes) "$SCRIPT_DIR/process-source" ;;
      buffers) "$SCRIPT_DIR/buffer-source" ;;
    esac
  } | awk -F '\t' -v stable="$TMUX_CANOPY_STABLE" -v nul="$TMUX_CANOPY_NUL" '
    !seen[$1]++ {
      if (stable) printf "%s\t%s\t%s", $1,$2,$1; else printf "%s", $0
      # BSD awk cannot retain NUL in strings; emit it directly.
      if (nul) printf "%c",0; else printf "\n"
    }
  '
}

# Stage complete records in memory, not diagnostic files. In particular, buffer
# samples must not become disk logs or orphaned snapshot files after SIGKILL.
records=()
source_pid=''
trap '[[ -z "$source_pid" ]] || kill "$source_pid" 2>/dev/null || true' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# Cache tree/Agents rows for the opt-in WORKING animator and keep one worker
# alive only while a working badge is visible.
schedule_animate() {
  local sidebar="${TMUX_PANE:-}" token cache
  [[ "$TMUX_CANOPY_NUL" == 1 && -n "$state_file" && "$sidebar" =~ ^%[0-9]+$ ]] || return 0
  cache="${state_file}.animate"
  if ! command -v perl >/dev/null 2>&1; then
    rm -f -- "$cache" "${state_file}.animate.frame"
    tmux set-option -pu -t "$sidebar" @tmux_canopy_animate_token 2>/dev/null || true
    return 0
  fi
  if [[ "$(tmux show-option -gqv @tmux_canopy_animate 2>/dev/null || true)" != on ||
        "$(tmux show-option -gqv @tmux-canopy-theme 2>/dev/null || true)" == mono ]]; then
    rm -f -- "$cache" "${state_file}.animate.frame"
    tmux set-option -pu -t "$sidebar" @tmux_canopy_animate_token 2>/dev/null || true
    return 0
  fi
  if ((${#records[@]})) && printf '%s\0' "${records[@]}" | grep -aEq 'WORKING|wrk'; then
    printf '%s\0' "${records[@]}" > "$cache"
    token="$$.$RANDOM"
    tmux set-option -p -t "$sidebar" @tmux_canopy_animate_token "$token" 2>/dev/null || true
    # shellcheck disable=SC2091 # tmux_shell builds a quoted argv for run-shell.
    tmux run-shell -b "$(tmux_shell "$SCRIPT_DIR/agent-animate" "$sidebar" "$token" "$state_file")" 2>/dev/null || true
  else
    rm -f -- "$cache" "${state_file}.animate.frame"
    tmux set-option -pu -t "$sidebar" @tmux_canopy_animate_token 2>/dev/null || true
  fi
}

exec {source_fd}< <(render_source 2>/dev/null)
source_pid=$!
if [[ "$TMUX_CANOPY_NUL" == 1 ]]; then
  mapfile -d '' -t records <&"$source_fd"
else
  mapfile -t records <&"$source_fd"
fi
exec {source_fd}<&-
wait "$source_pid"
rc=$?
source_pid=''
if ((rc == 0)); then
  if ((${#records[@]})); then
    if [[ "$TMUX_CANOPY_NUL" == 1 ]]; then printf '%s\0' "${records[@]}"
    else printf '%s\n' "${records[@]}"
    fi
  fi
  schedule_animate
  exit 0
fi
sidebar_failure "${TMUX_CANOPY_CLIENT:-}" source "Sidebar data unavailable (source exit $rc). Ctrl-r retries; a opens diagnostics."
record() {
  printf '%s\t%s' "$1" "$2"
  [[ "$TMUX_CANOPY_STABLE" == 1 ]] && printf '\t%s' "$1"
  if [[ "$TMUX_CANOPY_NUL" == 1 ]]; then printf '\0'; else printf '\n'; fi
}
record H:failure 'Sidebar data unavailable'
record V:failure 'Ctrl-r retry · a Diagnostics'
# A valid error record keeps the same fzf alive and supports reload recovery.
exit 0
