#!/usr/bin/env bash
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/launch-lib.sh"
state_file="${TMUX_CANOPY_STATE:-}"
export TMUX_CANOPY_STABLE=0 TMUX_CANOPY_NUL=0
# Old live UIs retain newline framing; only new UIs opt into NUL records.
[[ "${TMUX_CANOPY_RECORD_FORMAT:-}" == nul ]] && TMUX_CANOPY_NUL=1
for argument in "$@"; do
  case "$argument" in
    --stable) TMUX_CANOPY_STABLE=1 ;;
    --read0) TMUX_CANOPY_NUL=1 ;;
  esac
done
render_token=''
if [[ "${TMUX_CANOPY_UI_HEADER:-0}" == 1 && -n "$state_file" ]]; then
  render_token="${TMUX_CANOPY_RENDER_TOKEN:-$$.$RANDOM}"
  printf '%s\n' "$render_token" > "${state_file}.render"
fi

render_source() {
  set -o pipefail
  local view=tree kind value _rest
  [[ -r "$state_file" ]] || return 1
  while IFS=$'\t' read -r kind value _rest; do
    if [[ "$kind" == VIEW ]]; then view="$value"; break; fi
  done < "$state_file"
  if [[ "$view" == agents ]]; then
    if canopy_agents_enabled; then
      export TMUX_CANOPY_HEADER=1
      exec "$SCRIPT_DIR/tree-source" --agents
    fi
    view=tree
  fi
  if [[ "$view" != processes && "$view" != buffers ]]; then
    export TMUX_CANOPY_HEADER=1
    exec "$SCRIPT_DIR/tree-source"
  fi
  {
    # The header counts the view's rows, so they are built first.
    local body line count=0
    case "$view" in
      processes) body="$("$SCRIPT_DIR/process-source")" || return ;;
      buffers) body="$("$SCRIPT_DIR/buffer-source")" || return ;;
    esac
    while IFS= read -r line; do
      case "$line" in Q:*|X:*|B:*|B2:*) count=$((count + 1)) ;; esac
    done <<< "$body"
    TMUX_CANOPY_VIEW_COUNT=$count "$SCRIPT_DIR/view-header" || return
    [[ -z "$body" ]] || printf '%s\n' "$body"
  } | awk -F '\t' -v stable="$TMUX_CANOPY_STABLE" -v nul="$TMUX_CANOPY_NUL" '
    !seen[$1]++ {
      if (stable) printf "%s\t%s\t%s", $1,$2,$1; else printf "%s", $0
      # BSD awk cannot retain NUL in strings; emit it directly.
      if (nul) printf "%c",0; else printf "\n"
    }
  '
}

# Stage complete records in memory, not diagnostic files. In particular, buffer
# samples must not become disk logs or orphaned snapshot files after SIGKILL.
records=()
source_pid=''
trap '[[ -z "$source_pid" ]] || kill "$source_pid" 2>/dev/null || true' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# Cache tree/Agents rows for the opt-in WORKING animator and keep one worker
# alive only while a working badge is visible.
clear_animate() {
  local cache=$1 sidebar=$2
  # Most refreshes have nothing to clear; skip the rm and tmux forks.
  [[ -e "$cache" || -e "${cache}.prefix" ]] || return 0
  rm -f -- "$cache" "${cache}.prefix" "${cache}".f.* "${state_file}.animate.frame"
  tmux set-option -pu -t "$sidebar" @tmux_canopy_animate_token 2>/dev/null || true
}
schedule_animate() {
  local LC_ALL=C
  local sidebar="${TMUX_PANE:-}" token cache cache_tmp settings animate theme record working=0
  [[ "$TMUX_CANOPY_NUL" == 1 && -n "$state_file" && "$sidebar" =~ ^%[0-9]+$ ]] || return 0
  cache="${state_file}.animate"
  # Match the live working badge the renderer emits (bold-cyan accent, word or
  # mark, reset), not plain text such as a ~/wrk directory or a stale report's
  # dim mark; lib/animate.py uses the same pattern.
  local badge=$'\e\\[1;36m(WORKING|wrk|\xe2\x96\xb7[0-9]*)\e\\[0m'
  for record in "${records[@]}"; do
    if [[ "$record" == *$'\e[1;36m'* && "$record" =~ $badge ]]; then
      working=1
      break
    fi
  done
  if ((!working)) || ! command -v python3 >/dev/null 2>&1; then
    clear_animate "$cache" "$sidebar"
    return 0
  fi
  settings="$(tmux display-message -p -t "$sidebar" '#{?@tmux_canopy_animate,#{@tmux_canopy_animate},#{@tmux-canopy-animate}}|#{@tmux-canopy-theme}' 2>/dev/null || true)"
  animate=${settings%%|*} theme=${settings#*|}
  if [[ "${animate:-on}" != on || "$theme" == mono ]]; then
    clear_animate "$cache" "$sidebar"
    return 0
  fi
  cache_tmp="$(mktemp "${cache}.XXXXXX")" || return 0
  chmod 600 "$cache_tmp" 2>/dev/null || { rm -f -- "$cache_tmp"; return 0; }
  if ! printf '%s\0' "${records[@]}" > "$cache_tmp"; then
    rm -f -- "$cache_tmp"
    return 0
  fi
  # Retire the previous animator first, then drop its frames: they were
  # precomputed for the old cache and must not be served for this one.
  token="$$.$RANDOM"
  tmux set-option -p -t "$sidebar" @tmux_canopy_animate_token "$token" 2>/dev/null || true
  rm -f -- "${cache}.prefix"
  mv -f -- "$cache_tmp" "$cache"
  # shellcheck disable=SC2091 # tmux_shell builds a quoted argv for run-shell.
  tmux run-shell -b "$(tmux_shell "$SCRIPT_DIR/agent-animate" "$sidebar" "$token" "$state_file")" 2>/dev/null || true
}

# Sticky chrome is kept out of the live UI's selectable records. Standalone
# sources retain their header record for consumers of the snapshot protocol.
take_chrome() {
  local record footer='' header='' current='' index
  for index in "${!records[@]}"; do
    record=${records[index]}
    if [[ "$record" == F:$'\t'* ]]; then
      footer=${record#F:$'\t'}
      [[ "$TMUX_CANOPY_STABLE" != 1 ]] || footer=${footer%$'\t'F:}
    elif [[ "${TMUX_CANOPY_UI_HEADER:-0}" == 1 && "$record" == H:*$'\t'* ]]; then
      header=${record#*$'\t'}
      [[ "$TMUX_CANOPY_STABLE" != 1 ]] || header=${header%$'\t'*}
    else
      continue
    fi
    unset 'records[index]'
  done
  records=("${records[@]}")
  [[ -n "$state_file" && "$TMUX_CANOPY_NUL" == 1 ]] || return 0
  [[ -r "${state_file}.footer" ]] && IFS= read -r current < "${state_file}.footer"
  [[ "$current" == "$footer" && -e "${state_file}.footer" ]] || printf '%s\n' "$footer" > "${state_file}.footer"
  if [[ "${TMUX_CANOPY_UI_HEADER:-0}" == 1 ]]; then
    current=''
    [[ -r "${state_file}.header" ]] && IFS= read -r current < "${state_file}.header"
    [[ "$current" == "$header" && -e "${state_file}.header" ]] || printf '%s\n' "$header" > "${state_file}.header"
  fi
}

exec {source_fd}< <(render_source 2>/dev/null)
source_pid=$!
if [[ "$TMUX_CANOPY_NUL" == 1 ]]; then
  mapfile -d '' -t records <&"$source_fd"
else
  mapfile -t records <&"$source_fd"
fi
exec {source_fd}<&-
wait "$source_pid"
rc=$?
source_pid=''
# Only a staged background render can be discarded with no records: a direct
# fzf reload must still publish a complete list, never a transient empty one.
if [[ -n "$render_token" && -n "${TMUX_CANOPY_RENDER_TOKEN:-}" ]]; then
  current_token=''
  [[ -r "${state_file}.render" ]] && IFS= read -r current_token < "${state_file}.render"
  [[ "$current_token" == "$render_token" ]] || exit 0
fi
if ((rc == 0)); then
  take_chrome
  if ((${#records[@]})); then
    if [[ "$TMUX_CANOPY_NUL" == 1 ]]; then printf '%s\0' "${records[@]}"
    else printf '%s\n' "${records[@]}"
    fi
  fi
  schedule_animate
  exit 0
fi
sidebar_failure "${TMUX_CANOPY_CLIENT:-}" source "Sidebar data unavailable (source exit $rc). Ctrl-r retries; a opens diagnostics."
record() {
  if [[ "${TMUX_CANOPY_UI_HEADER:-0}" == 1 && "$1" == H:* ]]; then
    printf '%s\n' "$2" > "${state_file}.header"
    printf '\n' > "${state_file}.footer"
    return
  fi
  printf '%s\t%s' "$1" "$2"
  [[ "$TMUX_CANOPY_STABLE" == 1 ]] && printf '\t%s' "$1"
  if [[ "$TMUX_CANOPY_NUL" == 1 ]]; then printf '\0'; else printf '\n'; fi
}
record H:failure 'Sidebar data unavailable'
record V:failure 'Ctrl-r retry · a Diagnostics'
# A valid error record keeps the same fzf alive and supports reload recovery.
exit 0
