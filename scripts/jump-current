#!/usr/bin/env bash
# fzf transform action: position the pointer on the live content location.
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ "${TMUX_CANOPY_POPUP:-0}" == 1 ]]; then
  if [[ -r "${TMUX_CANOPY_STATE:-}.pos" ]]; then
    target=''
    read -r target < "${TMUX_CANOPY_STATE}.pos"
    if [[ "$target" =~ ^[1-9][0-9]*$ ]]; then
      printf 'change-query()+wait+pos(%s)\n' "$target"
      exit 0
    fi
  fi
  target_pane="${TMUX_CANOPY_TARGET:-${TMUX_PANE:-}}"
  location="$(tmux display-message -p -t "$target_pane" '#{session_id}|#{window_id}|#{pane_id}' 2>/dev/null || true)"
  if [[ -z "$location" && -n "${TMUX_CANOPY_CLIENT:-}" ]]; then
    location="$(tmux display-message -c "$TMUX_CANOPY_CLIENT" -p '#{session_id}|#{window_id}|#{pane_id}' 2>/dev/null || true)"
  fi
else
  sidebar="${TMUX_PANE:-}"
  [[ "$sidebar" =~ ^%[0-9]+$ ]] || { printf 'bell\n'; exit 0; }
  [[ "$(tmux show-option -pqv -t "$sidebar" @tmux_canopy 2>/dev/null || true)" == 1 ]] || { printf 'bell\n'; exit 0; }
  location="$(tmux show-option -pqv -t "$sidebar" @tmux_canopy_focus_location 2>/dev/null || true)"
fi
IFS='|' read -r session window pane <<< "$location"
if [[ ! "$session" =~ ^\$[0-9]+$ || ! "$window" =~ ^@[0-9]+$ || ! "$pane" =~ ^%[0-9]+$ ]]; then
  printf 'bell\n'
  exit 0
fi
# Render once and keep the rows: fzf reloads this same list below, so the
# position computed here is exact and no second render (Ctrl-r) is needed.
# The suffix keeps concurrent jumps apart; it is plain text because the path
# itself reaches fzf's reload shell only through $TMUX_CANOPY_STATE.
rows=''
suffix="rows.$$.$RANDOM"
if [[ -n "${TMUX_CANOPY_STATE:-}" ]]; then
  umask 077
  rows="$TMUX_CANOPY_STATE.$suffix"
  exec {rows_fd}> "$rows" 2>/dev/null || rows=''
fi
position=0 pane_position='' window_position='' session_position=''
while IFS= read -r -d '' record; do
  [[ -z "$rows" ]] || printf '%s\0' "$record" >&"$rows_fd"
  token="${record%%$'\t'*}"
  [[ "$token" == H:* ]] && continue
  ((position+=1))
  identity="${record##*$'\t'}"
  case "$identity" in
    "P:$pane:$session") pane_position="$position" ;;
    "W:$window:$session") window_position="$position" ;;
    "S:$session") session_position="$position" ;;
  esac
done < <("$SCRIPT_DIR/sidebar-source" --stable --read0)
reload=''
if [[ -n "$rows" ]]; then
  exec {rows_fd}>&-
  reload="reload-sync(cat \"\$TMUX_CANOPY_STATE.$suffix\"; rm -f \"\$TMUX_CANOPY_STATE.$suffix\")"
fi
target="${pane_position:-${window_position:-$session_position}}"
if [[ "$target" =~ ^[1-9][0-9]*$ ]]; then
  # If a search hides the target, clear the query before moving the pointer.
  # Query changes search asynchronously; wait before applying an absolute
  # position. The pointer moves at once, before the reload: --track then keeps
  # it on that row through the reload, and nothing typed meanwhile can land
  # between a reload and a late jump.
  printf 'change-query()+wait+pos(%s)%s\n' "$target" "${reload:++$reload}"
else
  printf '%sbell\n' "${reload:+$reload+}"
fi
