#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"

IFS='|' read -r configured minimum maximum min_content runtime < <(
  tmux display-message -p \
    '#{@tmux-canopy-width}|#{@tmux-canopy-min-width}|#{@tmux-canopy-max-width}|#{@tmux-canopy-min-content-width}|#{@tmux_canopy_runtime_width}' 2>/dev/null || true
)
: "${configured:=42}"
: "${minimum:=24}"
: "${maximum:=0}"
: "${min_content:=40}"

requested="$configured"
if [[ "$configured" =~ ^[1-9][0-9]*$ && "$runtime" =~ ^([1-9][0-9]*|[1-9][0-9]?%)$ ]]; then
  requested="$runtime"
fi
sidebar_width_expression "$requested" "$minimum" "$maximum" "$min_content"

while IFS='|' read -r sidebar owner restore_zoom; do
  [[ "$sidebar" =~ ^%[0-9]+$ ]] || continue
  sidebar_pid="$(tmux display-message -p -t "$sidebar" '#{pane_pid}' 2>/dev/null || true)"
  guard="$(sidebar_transition_option "$owner")"
  # Native predicates recheck live geometry/ownership at commit time. A queued
  # terminal-resize worker must not resize or kill a dock mid-navigation.
  resize="if-shell -F -t '$sidebar' '#{!=:#{pane_width},$SIDEBAR_WIDTH_FORMAT}' \"resize-pane -t $sidebar -x '$SIDEBAR_WIDTH_FORMAT'\" ; display-message -p kept"
  quoted_resize="${resize//\\/\\\\}"
  quoted_resize="${quoted_resize//\"/\\\"}"
  body="if-shell -F -t '$sidebar' '$SIDEBAR_WIDTH_FITS_FORMAT' \"$quoted_resize\" \"kill-pane -t $sidebar ; display-message -p closed\""
  quoted_body="${body//\\/\\\\}"
  quoted_body="${quoted_body//\"/\\\"}"
  # -C expands numeric formats before parsing resize-pane's -x argument,
  # entirely inside tmux (no shell worker for the geometry correction).
  result="$(tmux if-shell -F -t "$sidebar" "#{&&:#{==:#{@tmux_canopy},1},#{!=:#{$guard},1}}" \
    "run-shell -C -t '$sidebar' \"$quoted_body\"" 2>/dev/null || true)"
  if [[ "$result" == closed ]]; then
    signal_sidebar_group "$sidebar_pid"
    [[ -n "$owner" ]] && clear_sidebar_cache "$owner"
    if [[ "$restore_zoom" =~ ^%[0-9]+$ ]] && pane_exists "$restore_zoom"; then
      tmux resize-pane -Z -t "$restore_zoom" 2>/dev/null || true
    fi
  elif [[ "$result" == kept ]]; then
    # Do not replace the user's preferred width with this window's clamp.
    sync_sidebar_slots "$requested" "$minimum" "$maximum" "$min_content"
  fi
done < <(tmux list-panes -a -f '#{==:#{@tmux_canopy},1}' \
  -F '#{pane_id}|#{@tmux_canopy_client}|#{@tmux_canopy_restore_zoom_pane}' 2>/dev/null)
