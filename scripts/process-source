#!/usr/bin/env bash
set -u

theme="$(tmux show-option -gqv @tmux-canopy-theme 2>/dev/null || true)"
if [[ "$theme" == 'mono' ]]; then reset='' heading='' process_color='' dim=''
else reset=$'\033[0m'; heading=$'\033[1m'; process_color=''; dim=${CANOPY_COLOR_MUTED_ANSI:-$'\033[38;5;245m'}; fi

# etime is available on both BSD and procps; etimes is Linux-specific.
snapshot="$(ps -eo pid=,ppid=,user=,stat=,etime=,comm=,args= 2>/dev/null)" || exit 1
panes="$(tmux list-panes -a -F $'#{session_name}\037#{window_index}\037#{window_name}\037#{pane_id}\037#{pane_index}\037#{pane_pid}\037#{pane_current_command}\037#{pane_current_path}\037#{@tmux_canopy}\037#{@tmux_canopy_slot}' 2>/dev/null)" || exit 1

# Both providers must succeed before publishing rows. Index the process list
# once, then visit only each pane's descendants; unrelated processes are never
# reparsed per pane. Indexed child lists also avoid growing one large string.
awk -v heading="$heading" -v process_color="$process_color" -v dim="$dim" -v reset="$reset" '
  FILENAME == ARGV[1] {
    if (NF < 6 || $1 !~ /^[1-9][0-9]*$/ || $2 !~ /^[0-9]+$/) next
    pid=$1; ppid[pid]=$2
    if (known[pid]++) next
    user[pid]=clean($3); stat[pid]=clean($4); elapsed[pid]=elapsed_seconds($5); command[pid]=clean($6)
    children[ppid[pid],++child_count[ppid[pid]]]=pid
    # Remove the six metadata columns without rebuilding $0: preserve spaces
    # and literal backslashes in the command arguments.
    value=$0
    for (i=0; i<6; i++) sub(/^[[:space:]]*[^[:space:]]+[[:space:]]*/, "", value)
    args[pid]=clean(value)
    next
  }
  function elapsed_seconds(value,    days,parts,n,total,i) {
    days=0
    if (index(value,"-")) {
      split(value,parts,"-"); days=parts[1]; value=parts[2]
    }
    n=split(value,parts,":"); total=0
    for (i=1;i<=n;i++) total=total*60+parts[i]
    return days*86400+total
  }
  function clean(value) {
    gsub(/[[:cntrl:]]/, "", value)
    return value
  }
  # Hermes runs as Python (see canopy_hermes_args in lib/agent-process.sh).
  function hermes_args(value,    n,i,token,base) {
    if (index(value,"hermes_cli") > 0) return 1
    n=split(value,token,/[[:space:]]+/)
    for (i=2;i<=n;i++) {
      if (token[i] == "-m") return i < n && token[i+1] ~ /^tui_gateway(\.|$)/
      if (token[i] == "" || substr(token[i],1,1) == "-") continue
      base=token[i]; sub(/^.*\//,"",base)
      return base == "hermes" || base == "hermes-agent"
    }
    return 0
  }
  function is_claude_version(value) {
    return value ~ /^([0-9]+\.[0-9]+\.[0-9]+|[0-9]+_[0-9]+_[0-9]+)([-+][0-9A-Za-z._-]+)?$/
  }
  function hosted_name(comm, argline,    n,i,token,base,norm,skip_next) {
    if (is_claude_version(comm)) return "claude"
    n=split(argline,token,/[[:space:]]+/)
    if (n < 1) return ""
    base=token[1]; sub(/^.*\//,"",base); sub(/\.exe$/,"",base)
    if (is_claude_version(base)) return "claude"
    if ((comm == "MainThread" || comm ~ /^(node|nodejs|bun)$/) &&
        base ~ /^(claude|claude-code|codex|gemini|opencode|pi|omp|agent|cursor-agent|agy|antigravity|crush|copilot|grok)$/) {
      if (base == "claude-code") return "claude"
      if (base == "antigravity") return "agy"
      return base
    }
    if (base ~ /^(python[0-9.]*|Python)$/) return hermes_args(argline) ? "hermes" : ""
    if (base !~ /^(node|nodejs|bun)$/) return ""
    skip_next=0
    for (i=2;i<=n;i++) {
      if (token[i] == "") continue
      if (skip_next) { skip_next=0; continue }
      if (token[i] ~ /^(-r|--require|--import|--loader|--experimental-loader|-C|--conditions)$/) { skip_next=1; continue }
      if (token[i] ~ /^(-e|--eval|-p|--print|--eval=|--print=)/) return ""
      if (substr(token[i],1,1) == "-") continue
      base=token[i]; sub(/^.*\//,"",base); sub(/\.exe$/,"",base)
      if (base ~ /^(pi|omp|codex|gemini|opencode|copilot|grok|cursor-agent|crush)$/) return base
      if (base == "claude" || base == "claude-code") return "claude"
      if (base == "agy" || base == "antigravity") return "agy"
      norm=token[i]; gsub(/\\/,"/",norm)
      if (substr(norm,1,1) != "/") norm="/" norm
      if (index(norm,"/pi-coding-agent/") > 0) return "pi"
      if (index(norm,"/oh-my-pi/") > 0) return "omp"
      if (index(norm,"/@anthropic-ai/claude-code/") > 0) return "claude"
      if (index(norm,"/@google/gemini-cli/") > 0 || index(norm,"/gemini-cli/") > 0) return "gemini"
      if (index(norm,"/@openai/codex/") > 0) return "codex"
      if (index(norm,"/cursor-agent/") > 0) return "cursor-agent"
      if (index(norm,"/@github/copilot/") > 0) return "copilot"
      if (index(norm,"/opencode-ai/") > 0 || index(norm,"/node_modules/opencode/") > 0) return "opencode"
      return ""
    }
    return ""
  }
  function shown_command(pid,    hosted) {
    hosted=hosted_name(command[pid], args[pid])
    return hosted != "" ? hosted : command[pid]
  }
  function hosted_agent(root,    p,current,depth,best,found,hosted) {
    best=129; found=""
    for (p in command) {
      hosted=hosted_name(command[p], args[p])
      if (hosted == "") continue
      current=p
      for (depth=0; depth<128 && current>0; depth++) {
        if (current == root) {
          if (depth < best) { best=depth; found=hosted }
          break
        }
        if (seen_host[root,p,current]++) break
        current=ppid[current]
      }
    }
    return found
  }
  function emit(root, pane,    depth,parent,p) {
    # An explicit stack preserves sibling order without recursive shared-array
    # bugs or a recursion limit. A per-pane generation guards against cycles in
    # a racy snapshot while allowing descendants to appear under nested panes.
    generation++
    visited[root]=generation
    depth=0; parents[depth]=root; positions[depth]=1
    while (depth >= 0) {
      parent=parents[depth]
      if (positions[depth] > child_count[parent]) { depth--; continue }
      p=children[parent,positions[depth]++]
      if (visited[p] == generation) continue
      visited[p]=generation
      printf "X:%s:%s\t    %*s%s%s%s  %s%-7s %-5s %ss%s  %s\n", p, pane, depth*2, "", process_color, shown_command(p), reset, dim, user[p], stat[p], elapsed[p], reset, args[p]
      depth++; parents[depth]=p; positions[depth]=1
    }
  }
  {
    separator=(index($0, "\037") ? "\037" : "|")
    split($0, pane, separator)
    for (i=1; i<=10; i++) pane[i]=clean(pane[i])
    if (pane[4] !~ /^%[0-9]+$/ || pane[9] == "1" || pane[10] == "1" || seen_panes[pane[4]]++) next
    path=pane[8]; home=ENVIRON["HOME"]
    if (path == home) path="~"
    else {
      sub(/^.*\//, "", path)
      if (index(pane[8],home "/") == 1) path="…/" path
    }
    shown=pane[7]
    if (is_claude_version(shown)) shown="claude"
    else if (shown ~ /^(node|nodejs|bun|MainThread|python[0-9.]*|Python)$/) {
      hosted=hosted_agent(pane[6])
      if (hosted != "") shown=hosted
    }
    printf "Q:%s\t%s󰆍 %s%s %s/ 󰖯 %s:%s /  %s %s%s  %s%s%s\n", pane[4], heading, pane[1], reset, dim, pane[2], pane[3], pane[5], shown, reset, dim, path, reset
    if (pane[6] ~ /^[1-9][0-9]*$/) emit(pane[6],pane[4])
  }
' <(printf '%s\n' "$snapshot") - <<< "$panes"
