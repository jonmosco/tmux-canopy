#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"

mode="${1:-scan}"
client="${2:-}"

if [[ "$mode" == 'client' && -n "$client" ]]; then
  sidebar="$(sidebar_for_client "$client")"
  if [[ -n "$sidebar" ]]; then
    restore_zoom="$(tmux show-option -pqv -t "$sidebar" @tmux_canopy_restore_zoom_pane 2>/dev/null || true)"
    close_sidebar_pane "$sidebar" 2>/dev/null || true
    if [[ -n "$restore_zoom" ]] && pane_exists "$restore_zoom"; then
      tmux resize-pane -Z -t "$restore_zoom" 2>/dev/null || true
    fi
  fi
  clear_sidebar_cache "$client"
fi

# A split cannot invalidate caches or targets; it only needs a repaint. The
# hook already confirmed inside tmux that some sidebar exists (a new sidebar
# is not tagged until its process starts, so zero docks here is not "none").
if [[ "$mode" == 'split' ]]; then
  refresh_sidebars
  exit 0
fi

# One inventory of panes and attached clients replaces a list-panes | grep
# per cache entry and target.
declare -A live=() is_sidebar=() sidebar_target=() sidebar_window=() sidebar_owner=() attached=()
sidebar_count=0
# A tab separator would collapse empty fields (tab is IFS whitespace).
inventory="$(tmux list-clients -F 'C|#{client_tty}' \; \
  list-panes -a -F '#{pane_id}|#{@tmux_canopy}|#{@tmux_canopy_target}|#{window_id}|#{@tmux_canopy_client}' 2>/dev/null)" || exit 0
while IFS='|' read -r pane flag target window owner; do
  [[ -n "$pane" ]] || continue
  if [[ "$pane" == C ]]; then attached[$flag]=1; continue; fi
  live[$pane]=1
  if [[ "$flag" == 1 ]]; then
    is_sidebar[$pane]=1
    sidebar_target[$pane]=$target
    sidebar_window[$pane]=$window
    sidebar_owner[$pane]=$owner
    ((sidebar_count += 1))
  fi
done <<< "$inventory"

# A sidebar follows the terminal that opened it, so once that terminal is
# gone nothing moves or closes it. client-detached closes it at once; this
# catches one whose detach went unseen, such as across a plugin reload or
# from an older version. A sidebar with no recorded owner is left for toggle
# to adopt. A terminal attaching checks only this; closing a sidebar starts
# the usual after-kill-pane cleanup for the rest.
[[ "$mode" == orphans ]] && for sidebar in "${!is_sidebar[@]}"; do
  owner=${sidebar_owner[$sidebar]}
  [[ -n "$owner" && -z "${attached[$owner]:-}" ]] || continue
  close_sidebar_pane "$sidebar" 2>/dev/null || true
  clear_sidebar_cache "$owner"
  unset 'is_sidebar[$sidebar]'
  ((sidebar_count -= 1))
done
[[ "$mode" != orphans ]] || exit 0

# Remove cache entries whose pane vanished or no longer identifies itself as a
# sidebar. This also repairs interrupted toggles and killed sidebar processes.
while read -r option pane; do
  [[ "$option" =~ ^@tmux_canopy_client_[0-9]+$ ]] || continue
  # show-options quotes values; pane ids themselves never contain quotes.
  pane=${pane//[\"\']/}
  if [[ -z "$pane" || -z "${is_sidebar[$pane]:-}" ]]; then
    tmux set-option -gu "$option" 2>/dev/null || true
  fi
done < <(tmux show-options -g 2>/dev/null)

for sidebar in "${!is_sidebar[@]}"; do
  target=${sidebar_target[$sidebar]}
  if [[ -z "$target" || -z "${live[$target]:-}" ]]; then
    replacement="$(content_pane_for_window "${sidebar_window[$sidebar]}" 2>/dev/null || true)"
    [[ -n "$replacement" ]] && tmux set-option -p -t "$sidebar" @tmux_canopy_target "$replacement"
  fi
done

if ((sidebar_count == 0)); then
  cleanup_sidebar_slots
  tmux set-option -gu @tmux_canopy_runtime_width 2>/dev/null || true
elif [[ "$mode" == 'refresh' ]]; then
  refresh_sidebars
fi
