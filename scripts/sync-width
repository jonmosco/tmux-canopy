#!/usr/bin/env bash
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"

pane_id="${1:-}"
width="${2:-}"
[[ -n "$pane_id" && "$width" =~ ^[1-9][0-9]*$ ]] || exit 0
[[ "$(tmux show-option -pqv -t "$pane_id" @tmux_canopy 2>/dev/null || true)" == '1' ]] || exit 0

# Native mouse callbacks keep moving after the initial resize command. Its
# after-resize hook carries an intermediate width; the release handler owns
# the final commit and must not race a worker restoring that earlier width.
[[ "$(tmux display-message -p -t "$pane_id" '#{@tmux_canopy_drag_native}' 2>/dev/null)" != 1 ]] || exit 0

minimum="$(tmux show-option -gqv @tmux-canopy-min-width 2>/dev/null || true)"
maximum="$(tmux show-option -gqv @tmux-canopy-max-width 2>/dev/null || true)"
min_content="$(tmux show-option -gqv @tmux-canopy-min-content-width 2>/dev/null || true)"
: "${min_content:=40}"
: "${minimum:=24}"
: "${maximum:=0}"
requested="$width"
width="$(clamp_sidebar_width "$pane_id" "$requested" "$minimum" "$maximum" "$min_content")" || exit 0
current_width="$(tmux display-message -p -t "$pane_id" '#{pane_width}' 2>/dev/null || true)"
if [[ "$current_width" != "$width" ]]; then
  tmux resize-pane -t "$pane_id" -x "$width" 2>/dev/null || true
fi

nonce="$(date +%s%N)-$$"
tmux set-option -gq @tmux_canopy_resize_nonce "$nonce"
tmux set-option -gq @tmux_canopy_runtime_width "$requested"

# Interactive dragging can emit many resize hooks. Only the most recent width
# is propagated to inactive slot panes.
sleep 0.2
[[ "$(tmux show-option -gqv @tmux_canopy_resize_nonce 2>/dev/null || true)" == "$nonce" ]] || exit 0

[[ "$(tmux display-message -p -t "$pane_id" '#{@tmux_canopy_drag_native}' 2>/dev/null)" != 1 ]] || exit 0
sync_sidebar_slots "$requested" "$minimum" "$maximum" "$min_content"
