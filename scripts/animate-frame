#!/usr/bin/env bash
# Emit one animated frame from the cached tree snapshot (no tmux rescan).
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
state_file="${TMUX_CANOPY_STATE:-}"
cache="${state_file}.animate"
frame_file="${state_file}.animate.frame"
[[ -n "$state_file" && -r "$cache" ]] || exec "$SCRIPT_DIR/sidebar-source" --stable --read0
frame=0
[[ -r "$frame_file" ]] && frame="$(<"$frame_file")"
[[ "$frame" =~ ^[0-9]+$ ]] || frame=0
# agent-animate precomputes every frame once and publishes their prefix last,
# so a published prefix always names a complete set for the current cache.
prefix=''
[[ -r "${cache}.prefix" ]] && prefix="$(<"${cache}.prefix")"
[[ -n "$prefix" && -r "${prefix}.${frame}" ]] && exec cat -- "${prefix}.${frame}"
export TMUX_CANOPY_STABLE=1 TMUX_CANOPY_NUL=1
exec python3 "$SCRIPT_DIR/../lib/animate.py" "$frame" < "$cache"
