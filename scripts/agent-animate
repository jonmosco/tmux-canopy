#!/usr/bin/env bash
# Bounded WORKING-status animator. Starts only when a tree cache has WORKING,
# and exits when animation is off, the theme is mono, the sidebar closes, the
# view leaves Tree/Agents, or no working rows remain.
set -u
umask 077
sidebar="${1:-}"
token="${2:-}"
state_file="${3:-}"
[[ "$sidebar" =~ ^%[0-9]+$ && -n "$token" && -n "$state_file" ]] || exit 0
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cache="${state_file}.animate"
frame_file="${state_file}.animate.frame"
# One full cycle of every animated element; see PERIOD in lib/animate.py.
FRAMES=40
# Continue from the previous animator's frame so a refresh does not restart
# the highlight band.
frame=0
[[ -r "$frame_file" ]] && frame="$(<"$frame_file")"
[[ "$frame" =~ ^[0-9]+$ ]] && ((frame < FRAMES)) || frame=0
printf '%s\n' "$frame" > "$frame_file"

# Render every frame once so each tick's fzf reload is a plain cat. The
# token-scoped prefix is published only after the set is complete, and only
# while this animator still owns the sidebar.
prefix="${cache}.f.${token//[^A-Za-z0-9.]/_}"
# shellcheck disable=SC2317,SC2329 # Invoked by EXIT.
cleanup() {
  if [[ -r "${cache}.prefix" && "$(<"${cache}.prefix")" == "$prefix" ]]; then
    rm -f -- "${cache}.prefix"
  fi
  rm -f -- "$prefix".*
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP
if [[ -r "$cache" ]] && python3 "$SCRIPT_DIR/../lib/animate.py" --frames "$FRAMES" "$prefix" < "$cache" 2>/dev/null &&
   [[ "$(tmux display-message -p -t "$sidebar" '#{@tmux_canopy_animate_token}' 2>/dev/null || true)" == "$token" ]]; then
  printf '%s\n' "$prefix" > "${cache}.prefix.$$" && mv -f -- "${cache}.prefix.$$" "${cache}.prefix"
fi

# One tmux query per tick covers ownership, token, options and copy-mode.
status_format='#{@tmux_canopy}|#{@tmux_canopy_animate_token}|#{?@tmux_canopy_animate,#{@tmux_canopy_animate},#{@tmux-canopy-animate}}|#{@tmux-canopy-theme}|#{pane_in_mode}|#{&&:#{pane_active},#{window_active}}'
while sleep 0.15; do
  IFS='|' read -r owned current animate theme in_mode focused \
    < <(tmux display-message -p -t "$sidebar" "$status_format" 2>/dev/null || true)
  [[ "${owned:-}" == 1 && "${current:-}" == "$token" ]] || exit 0
  [[ "${animate:-on}" == on ]] || exit 0
  [[ "${theme:-}" != mono ]] || exit 0
  view=''
  while IFS=$'\t' read -r kind value _rest; do
    if [[ "$kind" == VIEW ]]; then view="$value"; break; fi
  done 2>/dev/null < "$state_file"
  [[ "$view" == tree || "$view" == agents || -z "$view" ]] || exit 0
  # sidebar-source removes the cache once no working badge remains.
  [[ -r "$cache" ]] || exit 0
  # Suppress animation until fzf has completed startup/load
  [[ -e "${state_file}.ready" ]] || continue
  # Suppress animation while search mode is open to prevent key leakage and typing disruption
  [[ ! -e "${state_file}.search" ]] || continue
  # Suppress animation if the pane is in copy-mode
  [[ "${in_mode:-}" == 0 ]] || continue
  # Pause while the sidebar has focus: every frame is an fzf reload, and fzf
  # drops clicks, scrolls, and keys that arrive during a reload. The animation
  # is for catching the eye from another pane; it resumes when focus leaves.
  [[ "${focused:-}" != 1 ]] || continue
  frame=$(( (frame + 1) % FRAMES ))
  printf '%s\n' "$frame" > "$frame_file"
  tmux send-keys -t "$sidebar" C-t 2>/dev/null || exit 0
done
