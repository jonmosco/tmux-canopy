#!/usr/bin/env bash
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

token="${1:-}"
[[ -n "$token" ]] || exit 0
clean=$'s/[\001-\037\177]/ /'

# Include all provider types in previews; the compact tree shows one badge.
notice_format() {
  local prefix="$1" present
  present="#{||:#{${prefix}activity},#{||:#{${prefix}bell},#{${prefix}silence}}}"
  printf '%s' "#{?#{==:#{@tmux_canopy_notifications},none},,#{?$present, · unread:,}#{?#{${prefix}activity}, activity,}#{?#{${prefix}bell}, bell,}#{?#{${prefix}silence}, silence,}}"
}
window_notices="$(notice_format @tmux_canopy_notice_)"
pane_notices="$(notice_format @tmux_canopy_notice_pane_)"

case "$token" in
  S:*)
    target="${token#S:}"
    tmux display-message -p -t "$target" \
      "Session: #{${clean}:session_name} · #{session_windows}w · #{session_attached} clients"$'\nWindows' 2>/dev/null
    tmux list-windows -t "$target" -F \
      "#{?window_active,●,○} #{window_index}:#{${clean}:window_name}  #{window_panes} panes#{?window_zoomed_flag, [Z],}$window_notices" 2>/dev/null
    ;;

  W:*)
    window_body="${token#W:}"
    target="${window_body%%:*}"
    [[ "$window_body" != *:* ]] || target="${window_body#*:}:$target"
    tmux display-message -p -t "$target" \
      "Window: #{${clean}:session_name}:#{window_index} #{${clean}:window_name}"$'\n'"#{window_width}x#{window_height} · #{window_panes} panes · #{window_linked_sessions} links#{?window_zoomed_flag, · zoomed,}$window_notices" 2>/dev/null
    tmux list-panes -t "$target" \
      -f '#{&&:#{!=:#{@tmux_canopy},1},#{!=:#{@tmux_canopy_slot},1}}' -F \
      "#{?pane_active,●,·} #{pane_id}  #{${clean}:pane_current_command}#{?#{&&:#{window_zoomed_flag},#{pane_active}}, [Z],}$pane_notices  #{${clean}:pane_current_path}" 2>/dev/null
    ;;

  P:*)
    exec "$SCRIPT_DIR/pane-preview" "${token#P:}"
    ;;
esac
