#!/usr/bin/env bash
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/launch-lib.sh"

state_file="${TMUX_CANOPY_STATE:?}"
view='tree'
mode=''
mode_color=$'\033[2m'
printf -v now '%(%s)T' -1

if [[ -r "$state_file" ]]; then
  has_move=0 has_link=0 has_delete=0
  while IFS=$'\t' read -r kind val stamp _; do
    case "$kind" in
      VIEW)   [[ -n "$val" ]] && view="$val" ;;
      MOVE)   has_move=1 ;;
      LINK)   has_link=1 ;;
      DELETE)
        if [[ "$stamp" =~ ^[0-9]+$ ]] && (( now - stamp <= 5 )); then
          has_delete=1
        fi
        ;;
    esac
  done < "$state_file"

  if ((has_move)); then
    mode='MOVE'; mode_color=$'\033[36;1m'
  elif ((has_link)); then
    mode='LINK'; mode_color=$'\033[36;1m'
  elif ((has_delete)); then
    mode='DELETE'; mode_color=$'\033[33;1m'
  fi
fi

pane_flag=()
[[ -n "${TMUX_PANE:-}" ]] && pane_flag=(-t "${TMUX_PANE:-}")
client="$(canopy_agents_client)"
agents_fmt="$(canopy_agents_format "$client")"

IFS='|' read -r width appearance theme agents_enabled < <(
  tmux display-message -p "${pane_flag[@]}" \
    "#{pane_width}|#{@tmux_canopy_appearance}|#{@tmux-canopy-theme}|${agents_fmt}" 2>/dev/null || true
)

[[ "$width" =~ ^[1-9][0-9]*$ ]] || width=42
: "${appearance:=classic}"
[[ "$agents_enabled" == on ]] || agents_enabled=off
# Match the tree renderer, including fzf's pointer gutter and right edge.
case "$view" in
  processes) selected=1 ;;
  buffers) selected=2 ;;
  agents) selected=1 ;;
  *) selected=0 ;;
esac
# Agents sits beside Tree, so later tabs shift one place while the mode is on.
if [[ "$agents_enabled" == on && "$selected" -gt 0 && "$view" != agents ]]; then
  selected=$((selected + 1))
fi
if [[ "$agents_enabled" != on && "$view" == agents ]]; then selected=0; fi
reserved=0
[[ -z "$mode" ]] || reserved=$((${#mode}+1))
box_pad=0
[[ "$appearance" == lazygit ]] && box_pad=3
for tier in full compact tiny; do
  case "$tier" in
    full) labels=('Tree') ;;
    compact) labels=('Tree') ;;
    tiny) labels=('T') ;;
  esac
  if [[ "$agents_enabled" == on ]]; then
    if [[ "$tier" == full ]]; then labels+=('Agents'); else labels+=('A'); fi
  fi
  case "$tier" in
    full) labels+=('Proc' 'Buff') ;;
    compact) labels+=('Proc' 'B') ;;
    tiny) labels+=('P' 'B') ;;
  esac
  if [[ "$appearance" != lazygit ]]; then
    labels[selected]="[${labels[selected]}]"
  fi
  tabs="${labels[*]}"
  (( ${#tabs} + reserved + box_pad <= width - 4 )) && break
done
accent=$'\033[1;36m'; reset=$'\033[0m'; dim=$'\033[2m'
if [[ "$theme" == mono ]]; then accent=''; reset=''; dim=''; mode_color=''; fi
printf 'H:\t'
if [[ "$appearance" == lazygit ]]; then
  printf '%s╭─ %s' "$accent" "$reset"
fi
for index in "${!labels[@]}"; do
  ((index == 0)) || printf ' '
  style="$dim"; ((index != selected)) || style="$accent"
  printf '%s%s%s' "$style" "${labels[index]}" "$reset"
done
if [[ -n "$mode" ]]; then
  padding=$((width - 2 - ${#tabs} - ${#mode} - box_pad))
  ((padding < 1)) && padding=1
  printf '%*s%b%s%s' "$padding" '' "$mode_color" "$mode" "$reset"
fi
printf '\n'
