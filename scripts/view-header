#!/usr/bin/env bash
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/launch-lib.sh"

state_file="${TMUX_CANOPY_STATE:?}"
view='tree'
mode=''
mode_color=$'\033[38;5;245m'
footer_hidden=0
printf -v now '%(%s)T' -1

if [[ -r "$state_file" ]]; then
  has_move=0 has_link=0 has_delete=0
  while IFS=$'\t' read -r kind val stamp _; do
    case "$kind" in
      VIEW)   [[ -n "$val" ]] && view="$val" ;;
      MOVE)   has_move=1 ;;
      LINK)   has_link=1 ;;
      DELETE)
        if [[ "$stamp" =~ ^[0-9]+$ ]] && (( now - stamp <= 5 )); then
          has_delete=1
        fi
        ;;
      FOOTER) [[ "$val" == off ]] && footer_hidden=1 ;;
    esac
  done < "$state_file"

  if ((has_move)); then
    mode='MOVE'; mode_color=$'\033[36;1m'
  elif ((has_link)); then
    mode='LINK'; mode_color=$'\033[36;1m'
  elif ((has_delete)); then
    mode='DELETE'; mode_color=$'\033[33;1m'
  fi
fi

pane_flag=()
[[ -n "${TMUX_PANE:-}" ]] && pane_flag=(-t "${TMUX_PANE:-}")
client="$(canopy_agents_client)"
agents_fmt="$(canopy_agents_format "$client")"

IFS='|' read -r width appearance theme icons agents_enabled < <(
  tmux display-message -p "${pane_flag[@]}" \
    "#{pane_width}|#{@tmux_canopy_appearance}|#{@tmux-canopy-theme}|#{@tmux_canopy_icon_theme}|${agents_fmt}" 2>/dev/null || true
)

[[ "$width" =~ ^[1-9][0-9]*$ ]] || width=42
: "${appearance:=classic}"
[[ "$agents_enabled" == on ]] || agents_enabled=off
accent=${CANOPY_COLOR_ACCENT_ANSI:-$'\033[1;36m'}
attention=${CANOPY_COLOR_ATTENTION_ANSI:-$'\033[1;33m'}
reset=$'\033[0m'; dim=${CANOPY_COLOR_MUTED_ANSI:-$'\033[38;5;245m'}
if [[ "$theme" == fixed ]]; then
  accent=$'\033[1;36m'; attention=$'\033[1;33m'
fi
if [[ "$theme" == mono ]]; then accent=''; attention=''; reset=''; dim=''; mode_color=''; fi
[[ "$mode" != DELETE ]] || mode_color=$attention
[[ "$mode" == MOVE || "$mode" == LINK ]] && mode_color=$accent
# Processes and Buffers name only the open view. Their footer advertises
# actions that work in that view rather than repeating inventory counts.
count="${TMUX_CANOPY_VIEW_COUNT:-}"
enter_key='↵'
[[ "$icons" != ascii ]] || enter_key=Enter
if [[ "$view" == processes ]]; then
  title=Processes short=Proc noun=process plural=processes
  footer=("$enter_key" 'focus' 'a' 'actions' 'p' 'preview' '/' 'search' '?' 'help')
else
  title=Buffers short=Buff noun=buffer plural=buffers
  footer=("$enter_key" 'paste' 'a' 'actions' 'x' 'delete' '/' 'search' '?' 'help')
fi
summary=''
if [[ "$count" =~ ^[0-9]+$ ]]; then
  summary="$count $plural"; ((count != 1)) || summary="1 $noun"
fi
right="$summary" right_style="$dim"
[[ -z "$mode" ]] || { right="$mode"; right_style="$mode_color"; }
prefix=''
if [[ "$appearance" == lazygit || "$appearance" == places ]]; then prefix='╭─ '; fi
available=$((width - 3 - ${#prefix}))
((${#title} + ${#right} + 2 <= available)) || title=$short
((${#title} + ${#right} + 2 <= available)) || right=''
printf 'H:\t'
[[ -z "$prefix" ]] || printf '%s%s%s' "$accent" "$prefix" "$reset"
printf '%s%s%s' "$accent" "$title" "$reset"
[[ -z "$right" ]] || printf '%*s%s%s%s' "$((available - ${#title} - ${#right}))" '' "$right_style" "$right" "$reset"
printf '\n'

if ((footer_hidden == 0)); then
  if [[ "$mode" == MOVE ]]; then
    footer_status=Moving
    footer=("$enter_key" 'move here' 'c' 'cancel')
  elif [[ "$mode" == LINK ]]; then
    footer_status=Linking
    footer=("$enter_key" 'link here' 'c' 'cancel')
  elif [[ "$mode" == DELETE ]]; then
    footer_status='x again within 5 s to delete'
    footer=()
  else
    footer_status=''
  fi
  plain="$footer_status" text="$footer_status"
  for ((index = 0; index < ${#footer[@]}; index += 2)); do
    part="${footer[index]} ${footer[index + 1]}"
    ((${#plain} + ${#part} + (${#plain} ? 2 : 0) <= width - 4)) || break
    [[ -z "$plain" ]] || { plain+='  '; text+='  '; }
    plain+="$part"; text+="${footer[index]} $dim${footer[index + 1]}$reset"
  done
  [[ -n "$text" ]] && printf 'F:\t%s\n' "$text"
fi
