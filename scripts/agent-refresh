#!/usr/bin/env bash
# Reload live sidebars without replacing fzf or changing the selected view.
# The pane-command monitor fires on every command start and exit (a shell
# running ls fires twice), so a burst of events shares one delayed worker.
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/launch-lib.sh"
if ! printf -v now '%(%s)T' -1 2>/dev/null || [[ -z "$now" ]]; then
  now="$(date +%s)"
fi

if [[ "${1:-}" != worker ]]; then
  # The claim is evaluated inside tmux's command queue, not in competing
  # shells. An expired claim recovers after a worker is killed.
  token="$now.$$.$RANDOM"
  job="run-shell -b $(tmux_quote "$(tmux_shell "$SCRIPT_DIR/agent-refresh" worker "$token")")"
  claim="set-option -gq @tmux_canopy_agent_refresh_pending $token ; set-option -gq @tmux_canopy_agent_refresh_deadline $((now + 2)) ; $job"
  tmux if-shell -F "#{||:#{!:#{@tmux_canopy_agent_refresh_pending}},#{<:#{@tmux_canopy_agent_refresh_deadline},$now}}" \
    "$claim" 2>/dev/null || true
  exit 0
fi

token="${2:-}"
[[ "$token" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || exit 0
match="#{==:#{@tmux_canopy_agent_refresh_pending},$token}"
release="set-option -gu @tmux_canopy_agent_refresh_pending ; set-option -gu @tmux_canopy_agent_refresh_deadline"
# shellcheck disable=SC2317,SC2329 # Invoked by the EXIT trap below.
release_claim() { tmux if-shell -F "$match" "$release" 2>/dev/null || true; }
trap release_claim EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
sleep 0.12
# Release before reading the panes: an event during the reads below starts a
# new worker instead of being absorbed by this one.
release_claim
trap - EXIT
delivery=()
while IFS='|' read -r pane sidebar client; do
  [[ $pane =~ ^%[0-9]+$ && $sidebar == 1 ]] || continue
  canopy_agents_enabled "$client" || continue
  ((${#delivery[@]} == 0)) || delivery+=(';')
  delivery+=(send-keys -t "$pane" C-r)
done < <(tmux list-panes -a -F '#{pane_id}|#{@tmux_canopy}|#{@tmux_canopy_client}' 2>/dev/null)
((${#delivery[@]} == 0)) || tmux "${delivery[@]}" 2>/dev/null || true
